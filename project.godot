; Engine configuration file.
; Pinned engine: Godot 4.6.3-stable (see docs/kb/decisions/0001-engine-version.md).

config_version=5

[application]

config/name="Hymn of the Undertow"
config/description="An original, cinematic, turn-based RPG."
run/main_scene="res://game/core/boot.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
run/main_scene.perf_build="res://tools/gpu_bench/slice_sweep.tscn"

[autoload]

EventBus="*res://game/core/event_bus.gd"
Game="*res://game/core/game.gd"
SaveSystem="*res://game/core/save_system.gd"
SceneRouter="*res://game/core/scene_router.gd"
UiInput="*res://game/ui/input/ui_input.gd"
Audio="*res://game/audio/audio_director.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[filesystem]

import/blender/enabled=false

[gui]

theme/custom="res://game/ui/theme/hymn_theme.tres"
theme/default_font_multichannel_signed_distance_field=false

[internationalization]

locale/translations=PackedStringArray("res://game/data/loc/strings.en.translation", "res://game/data/loc/dialogue.en.translation", "res://game/data/loc/menus.en.translation", "res://game/data/loc/menus_lattice.en.translation", "res://game/data/loc/menus_equip.en.translation", "res://game/data/loc/menus_items.en.translation", "res://game/data/loc/ch01.en.translation", "res://game/data/loc/menus_formation.en.translation", "res://game/data/loc/codex.en.translation", "res://game/data/loc/ch07.en.translation", "res://game/data/loc/ch05.en.translation", "res://game/data/loc/ch04.en.translation", "res://game/data/loc/ch09.en.translation", "res://game/data/loc/memories.en.translation", "res://game/data/loc/ch06.en.translation", "res://game/data/loc/ch08.en.translation", "res://game/data/loc/reefball_hud.en.translation", "res://game/data/loc/battle_set_piece.en.translation", "res://game/data/loc/ch10.en.translation", "res://game/data/loc/ch11.en.translation", "res://game/data/loc/ch12.en.translation", "res://game/data/loc/ch13.en.translation", "res://game/data/loc/ch14.en.translation", "res://game/data/loc/ch15.en.translation", "res://game/data/loc/ch16.en.translation", "res://game/data/loc/ch17.en.translation", "res://game/data/loc/ch18.en.translation", "res://game/data/loc/ch19.en.translation", "res://game/data/loc/ch20.en.translation", "res://game/data/loc/ch21.en.translation", "res://game/data/loc/shrine_travel.en.translation", "res://game/data/loc/kite.en.translation", "res://game/data/loc/maps_act2.en.translation", "res://game/data/loc/towns_act2.en.translation")

[shader_globals]

hymn_wind={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
hymn_wind_time={
"type": "float",
"value": 0.0
}
hymn_time_of_day={
"type": "float",
"value": 12.0
}
hymn_sun_direction={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
hymn_glimmer={
"type": "vec4",
"value": Vector4(1, 0.91, 0.72, 0)
}
hymn_glimmer_focus={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
hymn_zone_sea_glow={
"type": "float",
"value": 0.0
}
hymn_water_level={
"type": "vec2",
"value": Vector2(0, 0)
}
hymn_still_actor_0={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
hymn_still_actor_1={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
hymn_still_actor_heights={
"type": "vec2",
"value": Vector2(0, 0)
}

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/use_taa=true
environment/defaults/default_clear_color=Color(0.02, 0.05, 0.09, 1)
