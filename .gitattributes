# Normalize text
* text=auto eol=lf
*.gd text eol=lf
*.gdshader text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.dlg text eol=lf

# Binary assets: Git LFS is DEFERRED (ADR 0005). When enabled, uncomment these lines and
# run `git lfs migrate import` for existing binaries. Until then binaries are plain blobs
# and must stay small (< 5 MB each, enforced by tools/validate_data.py).
# *.blend filter=lfs diff=lfs merge=lfs -text
# *.glb filter=lfs diff=lfs merge=lfs -text
# *.png filter=lfs diff=lfs merge=lfs -text
# *.exr filter=lfs diff=lfs merge=lfs -text
# *.wav filter=lfs diff=lfs merge=lfs -text
# *.ogg filter=lfs diff=lfs merge=lfs -text
# *.ttf filter=lfs diff=lfs merge=lfs -text
# *.otf filter=lfs diff=lfs merge=lfs -text
# Screenshot baselines always stay plain git blobs so CI can diff them without LFS.
tests/screenshots/baselines/** binary
*.blend binary
*.glb binary
*.png binary
*.exr binary
*.wav binary
*.ogg binary
*.ttf binary
*.otf binary

# Git LFS (ADR 0039, live from 2026-10-28): new large binaries BY PATH only. Existing files stay plain git, and
# history is never migrated. Screenshot baselines always stay plain git. Cloud sessions skip LFS smudge, so run
# `git lfs pull` (tools/ci_local.sh does it).
assets/audio/music/act2/** filter=lfs diff=lfs merge=lfs -text
assets/audio/music/act3/** filter=lfs diff=lfs merge=lfs -text
assets/audio/music/act4/** filter=lfs diff=lfs merge=lfs -text
assets/lfs/** filter=lfs diff=lfs merge=lfs -text
# Godot's sidecar files stay plain text.
assets/audio/music/act*/**/*.import -filter -diff -merge text
assets/audio/music/act*/**/*.json -filter -diff -merge text
assets/lfs/**/*.import -filter -diff -merge text
