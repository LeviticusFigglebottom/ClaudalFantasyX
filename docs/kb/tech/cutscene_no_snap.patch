diff --git a/game/cutscene/cutscene_motion.gd b/game/cutscene/cutscene_motion.gd
index 3e0f0080..3263897a 100644
--- a/game/cutscene/cutscene_motion.gd
+++ b/game/cutscene/cutscene_motion.gd
@@ -66,3 +66,14 @@ static func _top_speed(dist: float, speed: float, r: Vector2) -> float:
 	if ramp_m <= dist or r.x + r.y <= 0.0:
 		return speed
 	return 2.0 * dist / (r.x + r.y)
+
+
+## Seconds until every actor walk and turn among a sequencer's running `motions` ("move:<id>" and "turn:<id>"
+## keys, each {elapsed, duration}) has ended (M2-HER-1113: a scene's end waits for them instead of jumping them).
+static func actor_motion_left(motions: Dictionary) -> float:
+	var left := 0.0
+	for key: StringName in motions.keys():
+		if String(key).begins_with("move:") or String(key).begins_with("turn:"):
+			var m: Dictionary = motions[key]
+			left = maxf(left, float(m["duration"]) - float(m["elapsed"]))
+	return left
diff --git a/game/cutscene/cutscene_sequencer.gd b/game/cutscene/cutscene_sequencer.gd
index 68e7d620..ce6c2b5a 100644
--- a/game/cutscene/cutscene_sequencer.gd
+++ b/game/cutscene/cutscene_sequencer.gd
@@ -320,9 +320,12 @@ func _begin(scene_id: StringName, stage: CutsceneStage) -> void:
 
 
 func _finish() -> void:
+	var skipped := _skipping
 	_skipping = false
 	_awaiting = &""
 	set_skip_held(false)
+	if not skipped and not _aborted:  # M2-HER-1113: a running walk or turn plays out rather than jump to its end
+		await _wait_for(CutsceneMotion.actor_motion_left(_motions))
 	_complete_motions()
 	_key_off()
 	if overlay != null:
@@ -563,7 +566,9 @@ func _cue_anim(step: DialogueStep) -> void:
 		_motions.erase(&"move:%s" % step.args[0])
 		var start := actor.global_position
 		var end := standin.global_position
-		var glide := float(config.get("standin_glide_sec", 0.0)) if start.distance_to(end) > 0.01 else 0.0
+		# M2-HER-1113: a mark farther than standin_cut_m is a cut (the shot changes with it), not a glide across it.
+		var far := start.distance_to(end)
+		var glide := float(config.get("standin_glide_sec", 0.0)) if far > 0.01 and far <= _standin_cut_m() else 0.0
 		var curve := float(config.get("turn_ease", 1.0))
 		_start_motion(
 			&"move:%s" % step.args[0],
@@ -864,6 +869,10 @@ func _start_motion(key: StringName, duration: float, apply: Callable) -> void:
 	_motions[key] = {"elapsed": 0.0, "duration": duration, "apply": apply}
 
 
+func _standin_cut_m() -> float:
+	return float(config.get("standin_cut_m", INF))
+
+
 func _complete_motions() -> void:
 	for key: StringName in _motions.keys():
 		((_motions[key] as Dictionary)["apply"] as Callable).call(1.0)
