+    log(f"body: {len(V)} verts, {len(F)} polygons ({time.time() - t0:.1f}s)")
+
+    # ---- rig on our landmarks; the donor's hand-made skin weights ------------------------------
+    meta = bb_rig.build_metarig(lm)
+    rig = bb_rig.generate_rig(meta)
