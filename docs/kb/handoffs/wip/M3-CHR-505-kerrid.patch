+            Q = part.varr()
+            for reg_name in (f"arm_{sd}", "torso", f"arm_{sd}", "torso"):  # the shoulder is a crease: one at a time
+                Q = by.push_out(Q, V, F, freg == reg_name, SLEEVE_CLEAR * S, by.SLEEVE_REACH * S)
