+        ab = seg_b - seg_a
+        u = float(np.clip((p[[0, 2]] - seg_a) @ ab / (ab @ ab), 0.0, 1.0))
+        return float(np.linalg.norm(p[[0, 2]] - (seg_a + ab * u))) < CLEAVER_FIN_BAND * S + 0.13 * S * u
