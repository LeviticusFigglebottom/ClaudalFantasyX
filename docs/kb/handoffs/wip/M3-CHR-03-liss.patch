+    # ---- hair: the crop (head-rigid) and the tail (its chain, the lower part on the upper chest) -------
+    head_i = wnames.index(HEAD_BONE)
+    hair_objs = []
+    hair_tris = 0
+    tail_root = np.zeros(3)
