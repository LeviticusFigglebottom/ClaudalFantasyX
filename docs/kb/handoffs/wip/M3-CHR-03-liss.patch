+    for ex in extras:
+        head.extend(ex)
+    Vhead = head.varr()
+    ob_head = hb.make_object("Head", Vhead, head.F, head.UV, head.M)
+    me = ob_head.data
+    auto = np.zeros((len(me.vertices), 3))
