+            # what keeps a hanging arm clear of it; arm weights there carried the rim out with the arm)
+            top = smooth01((Pb[:, 2] - (sh_z - GUSSET_FROM_BELOW_SHOULDER * lm.S)) / (0.04 * lm.S))
