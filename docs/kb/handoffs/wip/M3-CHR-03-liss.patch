+        rest = add(bend, {"DEF-upper_arm.L": (-46.0, 8.0, 26.0), "DEF-forearm.L": (-22.0, 16.0, 0.0),
+                          "DEF-hand.L": (0.0, 0.0, 10.0),
+                          "DEF-upper_arm.R": (-46.0, -8.0, -26.0 - LISS_LAUNCHER_ARM),
