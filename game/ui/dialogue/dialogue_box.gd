class_name DialogueBox
extends Control
## Minimal dialogue text box: speaker name, typewriter reveal, and a per-speaker blip
## (assets/audio/sfx/text_blip.ogg pitched by speakers.json). Feed it LINE steps from a
## DialogueRunner; it resolves text with tr(). Lip-flap is not done here: mouth_flap fires for
## each revealed vowel (open) and the first non-vowel after it (closed) so Cinematics can hook in.
## It no longer snaps (DialogueBoxMotion): shown, its panel fades and rises in; a new speaker's name fades
## in; dismiss() fades it out before hiding it. Reduced motion makes all of it instant.

signal reveal_finished
signal mouth_flap(speaker: StringName, open: bool)
## The player pressed accept after the line was fully shown.
signal advance_requested
## M3-ARC-03: a blip is due for `voice` (the speaker, or the narrator identity on narration), whether or not the
## box's own Blip player sounds it (external_voice). Audio's VoiceAudio voices it.
signal blip(voice: StringName)
## M3-ARC-03: show_line() started `step` (its speaker, line id and tags).
signal line_started(step: DialogueStep)

## Generated by Godot from game/data/loc/dialogue.csv (tools/dlgc.py writes the CSV).
const DIALOGUE_TRANSLATION := "res://game/data/loc/dialogue.en.translation"
const TRANSLATIONS_SETTING := "internationalization/locale/translations"
## The tag of a voice-over line (#vo): it reads as a subtitle, as narration does (M2-UI-100).
const TAG_VO := "vo"
## Theme type variation of the body Label on #sung lines; UI styles it in the project theme
## (until then it falls back to the plain Label style).
const SUNG_VARIATION := &"DialogueBodySung"
## Float slack when comparing reveal times (a character due at exactly the elapsed time shows).
const REVEAL_EPSILON_SEC := 0.000001
const PORTRAIT_DATA := "res://game/data/ui/dialogue_portrait.json"

static var _translation_added: bool = false

## Leave null to load the defaults from the data files in _ready().
var settings: DialogueTextSettings
var speakers: DialogueSpeakers
## Count of blips actually played; tests and debug overlays read it.
var blips_played: int = 0
## M3-ARC-03: something else voices the blips (VoiceAudio on the blip signal), so the box's own Blip player stays
## quiet; blips are still counted and emitted.
var external_voice := false

var _speaker: StringName = &""
## Whose blip pitch to use: the speaker, or the narrator identity for narration.
var _voice: StringName = &""
var _sung: bool = false
var _text: String = ""
var _elapsed: float = 0.0
## When each character becomes visible (DialogueTextSettings.reveal_times; M2-UI-27).
var _times := PackedFloat64Array()
var _shown: int = 0
var _revealing: bool = false
var _mouth_open: bool = false
var _blip_chars: int = 0
## The name key on show (a different one fades the name in).
var _name_key: StringName = &""
## True while the line on show is narration or voice-over (M2-UI-100: SubtitleStyle draws it as a subtitle).
var _voice_over := false
var _motion: DialogueBoxMotion
var _spoken_rest := Vector2.ZERO
## The speaker's portrait at the box's left (Act I final pass; game/data/ui/dialogue_portrait.json).
var _portrait: HeroPortraitFrame
## Each speaker's last emotion tag (an untagged line keeps it).
var _emotions: Dictionary = {}

@onready var _name_label: Label = %SpeakerName
@onready var _body_label: Label = %Body
@onready var _blip: AudioStreamPlayer = %Blip


## Registers the dialogue translation if project.godot does not list it yet.
static func ensure_translations() -> void:
	if _translation_added:
		return
	_translation_added = true
	var listed: PackedStringArray = ProjectSettings.get_setting(TRANSLATIONS_SETTING, PackedStringArray())
	if DIALOGUE_TRANSLATION in listed:
		return
	if not ResourceLoader.exists(DIALOGUE_TRANSLATION):
		push_warning("DialogueBox: %s not imported yet; lines will show their keys" % DIALOGUE_TRANSLATION)
		return
	var t := load(DIALOGUE_TRANSLATION) as Translation
	if t != null:
		TranslationServer.add_translation(t)


func _ready() -> void:
	ensure_translations()
	if settings == null:
		settings = DialogueTextSettings.load_default()
	if speakers == null:
		speakers = DialogueSpeakers.load_default()
	_blip.volume_db = settings.blip_volume_db
	clear()
	var panel := get_node(^"Panel") as Control
	_spoken_rest = Vector2(panel.offset_top, panel.offset_bottom)
	_build_portrait()
	_motion = DialogueBoxMotion.new(self, panel, _name_label)
	DialogueAssist.attach(self)  # M2-UI-25: continue glyph, backlog, auto-advance (UI-owned)


func _notification(what: int) -> void:
	if what == NOTIFICATION_VISIBILITY_CHANGED and visible and _motion != null and not _motion.is_dismissing():
		_motion.play_in()


func _process(delta: float) -> void:
	if _revealing:
		advance(delta)


func _unhandled_input(event: InputEvent) -> void:
	if not visible or not event.is_action_pressed(&"ui_accept"):
		return
	if _revealing:
		skip_reveal()
	else:
		advance_requested.emit()
	get_viewport().set_input_as_handled()


func show_line(step: DialogueStep) -> void:
	var vo := step.speaker == &"" or TAG_VO in step.tags
	if step.emotion != &"":
		_emotions[step.speaker] = step.emotion
	line_started.emit(step)
	show_text(step.speaker, step.text_key, step.name_key, step.is_sung(), step.narrator, vo)


## Shows `speaker`'s portrait in `emotion` (hidden for &"" or a speaker with no picture).
func show_portrait(speaker: StringName, emotion: StringName = &"") -> void:
	if _portrait == null:
		return
	var who := portrait_for(speaker)
	_portrait.show_hero(who, "", emotion)
	_portrait.visible = who != &""


## The character whose portrait `speaker` shows (dialogue_portrait.json aliases), or &"" when none is baked.
static func portrait_for(speaker: StringName) -> StringName:
	if speaker == &"":
		return &""
	var d := _portrait_data()
	var who := StringName(str((d.get("aliases", {}) as Dictionary).get(String(speaker), speaker)))
	return who if HeroPortraits.texture(who) != null else &""


## The portrait on show (null while hidden; tests).
func portrait() -> HeroPortraitFrame:
	return _portrait if _portrait != null and _portrait.visible else null


static func _portrait_data() -> Dictionary:
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(PORTRAIT_DATA))
	return (parsed as Dictionary).get("dialogue_portrait", {}) as Dictionary if parsed is Dictionary else {}


## Puts the portrait to the left of the name and text: Margin > HBox > [portrait, VBox].
func _build_portrait() -> void:
	var vbox := _name_label.get_parent()
	var margin := vbox.get_parent()
	var d := _portrait_data()
	var px := HudLayout.num(d, "size_px")
	var row := HBoxContainer.new()
	row.add_theme_constant_override(&"separation", int(HudLayout.num(d, "gap_px")))
	row.mouse_filter = Control.MOUSE_FILTER_IGNORE
	margin.remove_child(vbox)
	margin.add_child(row)
	_portrait = HeroPortraitFrame.new()
	_portrait.custom_minimum_size = Vector2(px, px)
	_portrait.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	_portrait.visible = false
	row.add_child(_portrait)
	row.add_child(vbox)
	(vbox as Control).size_flags_horizontal = Control.SIZE_EXPAND_FILL
	# Moving the column dropped its owner; give it back so %SpeakerName and %Body still resolve.
	row.owner = self
	vbox.owner = self
	for n in vbox.get_children():
		n.owner = self


## Starts revealing tr(text_key). An empty speaker means narration (no name, no blip by default).
## `display_name_key` overrides the speaker's name (an alias). A `sung` line reveals silently,
## with no blips and no mouth_flap, and uses the SUNG_VARIATION label style. `narrator` (a speaker
## id) only picks the blip pitch of narration, when text_box.json turns narration blips on.
func show_text(
	speaker: StringName,
	text_key: StringName,
	display_name_key: StringName = &"",
	sung: bool = false,
	narrator: StringName = &"",
	voice_over: bool = false
) -> void:
	_speaker = speaker
	_voice_over = voice_over or speaker == &""
	_voice = speaker if speaker != &"" else narrator
	_sung = sung
	var name_key := &""
	if speaker != &"":
		# M3-C09-05: a name the party hasn't learned yet ("The Kirru") comes from CharacterNames.
		var own := StringName(CharacterNames.key_for(speaker, String(speakers.name_key(speaker))))
		name_key = display_name_key if display_name_key != &"" else own
	_name_label.text = tr(name_key) if name_key != &"" else ""
	_name_label.visible = name_key != &""
	show_portrait(&"" if _voice_over else speaker, StringName(str(_emotions.get(speaker, ""))))
	if _motion != null:
		if _motion.is_dismissing():
			_motion.play_in()  # a line arrived while it was going: it comes back
		elif name_key != _name_key and name_key != &"" and visible:
			_motion.play_name()
	_name_key = name_key
	_body_label.theme_type_variation = SUNG_VARIATION if sung else &""
	_text = InputNames.fill(tr(text_key))  # {action} names the binding, for the last device (M2-UI-26)
	_body_label.text = _text
	_body_label.visible_characters = 0
	_elapsed = 0.0
	_times = settings.reveal_times(_text)
	_shown = 0
	_blip_chars = 0
	_mouth_open = false
	_revealing = true
	if _text.is_empty():
		_end_reveal()


## Advances the reveal by `delta` seconds at settings.chars_per_sec (called from _process).
func advance(delta: float) -> void:
	if not _revealing:
		return
	if settings.chars_per_sec <= 0.0:
		skip_reveal()
		return
	_elapsed += delta
	var target := _shown
	while target < _times.size() and _times[target] <= _elapsed + REVEAL_EPSILON_SEC:
		target += 1
	_reveal_to(target, true)


## Shows the rest of the line at once, without blips or flaps.
func skip_reveal() -> void:
	if _revealing:
		_reveal_to(_text.length(), false)


## When character `i` of the line on show becomes visible, in seconds from the line's start,
## punctuation pauses included (M2-UI-27). Lip sync follows this instead of i / chars_per_sec.
## 0 for an instant reveal.
func time_of_char(i: int) -> float:
	if _times.is_empty():
		return 0.0
	return _times[clampi(i, 0, _times.size() - 1)]


## When each character of the line on show becomes visible (a copy; empty for an instant reveal).
## LipSync takes it whole (M2-CHR-10, LipSync.starts_for).
func reveal_times() -> PackedFloat64Array:
	return _times.duplicate()


## How long the whole line takes to reveal (seconds; 0 for an instant reveal).
func reveal_duration() -> float:
	return _times[_times.size() - 1] if not _times.is_empty() else 0.0


func is_revealing() -> bool:
	return _revealing


func set_chars_per_sec(value: float) -> void:
	settings.set_chars_per_sec(value)


## Fades the box out, then hides it (DialogueBoxMotion.dismissed; at once under Reduced motion). Use it
## instead of `visible = false` where the box should not snap away (the end of a scene).
func dismiss() -> void:
	if visible and _motion != null:
		_motion.play_out()
	else:
		visible = false


## True while the line on show is narration or a #vo line (drawn as a subtitle, M2-UI-100).
func is_voice_over() -> bool:
	return _voice_over


## Where the panel rests (its top and bottom offsets from the screen's bottom edge): SubtitleStyle moves it
## for voice-over lines. The box's motion lands there.
func set_panel_rest(top: float, bottom: float) -> void:
	if _motion != null:
		_motion.set_rest(top, bottom)


## The panel's rest offsets from the scene (spoken lines), [top, bottom].
func spoken_panel_rest() -> Vector2:
	return _spoken_rest


## The box's transitions (null before _ready). Tests drive them with motion().finish().
func motion() -> DialogueBoxMotion:
	return _motion


func clear() -> void:
	_name_key = &""
	_voice_over = false
	_revealing = false
	_speaker = &""
	_voice = &""
	_sung = false
	_text = ""
	_name_label.text = ""
	_name_label.visible = false
	_body_label.text = ""


func shown_text() -> String:
	return _text.substr(0, _shown)


func speaker_name() -> String:
	return _name_label.text if _name_label.visible else ""


func _reveal_to(target: int, animate: bool) -> void:
	while _shown < target:
		_on_char_revealed(_text[_shown], animate)
		_shown += 1
	_body_label.visible_characters = _shown
	if _shown >= _text.length():
		_end_reveal()


func _on_char_revealed(ch: String, animate: bool) -> void:
	if not animate or _sung:
		return
	if settings.flap_vowels.contains(ch):
		_mouth_open = true
		mouth_flap.emit(_speaker, true)
	elif _mouth_open:
		_mouth_open = false
		mouth_flap.emit(_speaker, false)
	if ch.strip_edges().is_empty():
		return
	_blip_chars += 1
	if _blip_chars % settings.blip_every_n_chars == 0:
		_play_blip()


func _play_blip() -> void:
	if _speaker == &"" and not settings.narration_blip:
		return
	blips_played += 1
	blip.emit(_voice)
	if external_voice:
		return
	_blip.pitch_scale = speakers.blip_pitch(_voice)
	if _blip.is_inside_tree():
		_blip.play()


func _end_reveal() -> void:
	_revealing = false
	_body_label.visible_characters = -1
	if _mouth_open:
		_mouth_open = false
		mouth_flap.emit(_speaker, false)
	reveal_finished.emit()
