class_name ResidentLoads
extends Node
## Scenes kept loaded for the session, loaded on worker threads behind the fade (ADR 0111, under ADR 0029).
##
## A zone's first frame used to read every hero body from disk on the main thread (HeroFieldActor.attach, the
## battle stand-ins): one hidden frame of 1.3-3 s on the PC. ResidentLoads loads those scenes with
## ResourceLoader.load_threaded_request when a change starts (SceneRouter.change_started), holds the router's
## swap (hold_swap) until they are in, and keeps a reference to each, so their load() in the new scene finds
## them in the cache and every later change pays nothing. warm() starts the loads without a hold (the title).
## The zone's own runtime loads (its villagers, its kit pieces and materials: game/data/ui/scene_loads.json, written
## by tools/loading/scene_loads.gd) load the same way, behind the same hold, and are dropped at the next change.
## Paths: game/data/ui/resident_loads.json. Hook-up: `ResidentLoads.install(SceneRouter)`, like ShaderPrewarm.

const DATA_PATH := "res://game/data/ui/resident_loads.json"
const ENCOUNTERS_PATH := "res://game/data/battle/encounters.json"
## Per zone, the resources it holds once in the tree (generated by tools/loading/scene_loads.gd).
const SCENE_LOADS_PATH := "res://game/data/ui/scene_loads.json"
const NAME := &"ResidentLoads"
const ROUTER_SIGNAL := &"change_started"
## swap_wait_progress() counts a finished load as this many units, an in-flight one by its fraction of it.
const PROGRESS_SCALE := 1000

## Off in a headless run (the test suite: nothing draws, and every test's change_scene would wait on the heroes);
## tests of this class turn it on.
static var run_headless := false

## path -> the loaded Resource, kept for the session.
var resident: Dictionary = {}
## path -> the loaded Resource for the zone being entered, kept until the next change (then dropped).
var scene: Dictionary = {}
## Paths not in yet: loading (at most max_in_flight at once) or queued.
var pending: PackedStringArray = []
## True while this node holds its parent router's swap.
var holding := false

var _data: Dictionary = {}
var _scene_loads: Dictionary = {}
## The paths the zone being entered wants (they go to `scene`, not `resident`).
var _scene_wanted: Dictionary = {}
## ADR 0111 amendment 4: the zone's runtime materials and scenes as their loads finish, for ShaderPrewarm to stage
## under the cover (take_prewarm). A zone's dressing builds at runtime, so the prewarm's own scene scan never sees it.
var _prewarm_queue: Array[Resource] = []
## The paths requested from the loader and not in yet (at most max_in_flight).
var _in_flight: PackedStringArray = []
var _done_count := 0
## The resident paths warm() asked for (a path both lists name stays resident).
var _resident_wanted: Dictionary = {}
## The scene load_scene() last loaded for (M3-HER-1167: the title starts the first zone's loads early).
var _scene_path := ""
## The paths the change in progress needs (the zone's own and the party's heroes): queued first, and the only ones
## the swap's hold waits for. The rest (the heroes not in the party yet, kept for the session) load on after the reveal
## (the PC's ~12 s first Haluna entry: Liss's, Sefir's, Kerrid's and Pell's bodies held a Ch2 swap, 16.9 s -> 10 s).
var _needed: Dictionary = {}


## Adds a ResidentLoads under `router` and connects it to the router's change_started. Idempotent.
static func install(router: Node) -> ResidentLoads:
	var existing := router.get_node_or_null(NodePath(String(NAME))) as ResidentLoads
	if existing != null:
		return existing
	var r := ResidentLoads.new()
	r.name = NAME
	router.add_child(r)
	if router.has_signal(ROUTER_SIGNAL):
		router.connect(ROUTER_SIGNAL, r._on_change_started)
	return r


## The ResidentLoads under SceneRouter, or null (no router in this tree).
static func shared() -> ResidentLoads:
	var tree := Engine.get_main_loop() as SceneTree
	var router := tree.root.get_node_or_null(^"SceneRouter") if tree != null else null
	return router.get_node_or_null(NodePath(String(NAME))) as ResidentLoads if router != null else null


static func load_data() -> Dictionary:
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(DATA_PATH))
	if not parsed is Dictionary:
		push_error("ResidentLoads: could not read %s" % DATA_PATH)
		return {}
	return (parsed as Dictionary).get("resident_loads", {}) as Dictionary


## The scenes to keep resident for a party of `party` (hero ids): every source's rows (party_only sources: the
## party's and leader_default's), then the fixed paths. Missing files are left out.
static func paths_for(data: Dictionary, party: Array[StringName]) -> PackedStringArray:
	var keep: Array[String] = [str(data.get("leader_default", ""))]
	for id in party:
		keep.append(String(id))
	var out := PackedStringArray()
	for src: Dictionary in data.get("sources", []):
		var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(str(src.get("json", ""))))
		var table: Variant = parsed
		for key: Variant in src.get("table", []):
			table = (table as Dictionary).get(str(key), {}) if table is Dictionary else {}
		if not table is Dictionary:
			continue
		for id: String in table:
			if bool(src.get("party_only", false)) and not keep.has(id):
				continue
			var path := str(((table as Dictionary)[id] as Dictionary).get(str(src.get("key", "")), ""))
			if path != "" and not out.has(path) and ResourceLoader.exists(path):
				out.append(path)
	for p: Variant in data.get("paths", []):
		if ResourceLoader.exists(str(p)) and not out.has(str(p)):
			out.append(str(p))
	return out


## Starts loading every resident path not yet loaded or loading, on worker threads. No hold.
func warm() -> void:
	_ensure_data()
	var party: Array[StringName] = []
	if Game.state != null:
		party = Game.state.party_ids.duplicate()
	_needed = {}
	for path in paths_for(party_data(_data), party):
		_needed[path] = true
	for path in paths_for(_data, party):
		_resident_wanted[path] = true
		if scene.has(path):  # loaded for a zone first: it stays now
			resident[path] = scene[path]
			scene.erase(path)
		if resident.has(path) or pending.has(path):
			continue
		pending.append(path)
	_pump()


## Starts loading the resources `scene_path` holds once in the tree (scene_loads.json), on worker threads, and
## drops the last zone's. No hold. The title calls it early for the zone its highlighted choice enters (M3-HER-1167).
func load_scene(scene_path: String) -> void:
	_ensure_data()
	var wanted := {}
	var request := BattleRequest.pending()
	var to_battle := request != null and scene_path == BattleRequest.scene_path()
	if to_battle:
		for p in battle_paths(request.encounter):
			wanted[p] = true
		# The human playtest (2026-10-30): after a won fight the field took seconds of black to come back, because
		# the zone's loads were let go here and read again from disk on the return. A field battle keeps them.
		for path: String in scene.keys():
			wanted[path] = true
	for p: Variant in _scene_loads.get(scene_path, []):
		var path := str(p)
		if ResourceLoader.exists(path):
			wanted[path] = true
	for path: String in scene.keys():
		if not wanted.has(path):
			scene.erase(path)
	_scene_wanted = wanted
	for path: String in wanted:
		_needed[path] = true
	# The same zone asked again (the title started its loads; now its change starts): what is in and still waits
	# for the prewarm stays queued, so its pipelines still compile under the cover.
	if scene_path != _scene_path:
		_prewarm_queue.clear()
	_scene_path = scene_path
	for path: String in wanted:
		if resident.has(path) or scene.has(path) or pending.has(path):
			continue
		pending.append(path)
	_pump()


## The scene a won (or escaped) field battle returns to: its own return_scene, else return_location's scene; "" when
## none resolves. `registry` defaults to LocationRegistry.load_default().
static func return_scene_of(request: BattleRequest, registry: LocationRegistry = null) -> String:
	if request == null:
		return ""
	if request.return_scene != "":
		return request.return_scene
	if request.return_location == &"":
		return ""
	var reg := registry if registry != null else LocationRegistry.load_default()
	return str(reg.resolve(request.return_location).get(LocationRegistry.KEY_SCENE, ""))


## The Lead's battle-return work (2026-10-30): while the victory panel stays up (a second or more), the scene the
## return goes to starts loading, so a scripted fight that ends somewhere new (the Drownbell to Haluna) finds most of
## it in. Nothing when the return is the field kept resident through the fight (SceneRouter.resident_path()), or
## when it resolves to nothing. Returns the scene asked for ("" when none).
func prepare_return(request: BattleRequest, resident_path: String = "", registry: LocationRegistry = null) -> String:
	var to := return_scene_of(request, registry)
	if to == "" or to == resident_path:
		return ""
	load_scene(to)
	return to


## A field battle's runtime loads for `encounter`: its arena scene (encounters.json `arena`) and each enemy's actor
## scene (BattleStage.stand_in_spec, the battle's own lookup). Missing files are left out.
static func battle_paths(encounter: StringName) -> PackedStringArray:
	var out := PackedStringArray()
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(ENCOUNTERS_PATH))
	var rows: Variant = (parsed as Dictionary).get("encounters", []) if parsed is Dictionary else parsed
	for row: Dictionary in rows as Array:
		if str(row.get("id", "")) != String(encounter):
			continue
		var arena := BattleArena.scene_of(str(row.get("arena", "")))
		if arena != "" and ResourceLoader.exists(arena):
			out.append(arena)
		for e: Variant in row.get("enemies", []):
			var scene_path := str(BattleStage.stand_in_spec(StringName(str(e))).get("scene", ""))
			if scene_path != "" and ResourceLoader.exists(scene_path) and not out.has(scene_path):
				out.append(scene_path)
	return out


## How far the loads have got, in thousandths of a load: finished loads plus each one in flight's own progress
## (SceneRouter.swap_progress: a held swap waits on while this rises, ADR 0111). One big scene can take longer
## than the router's stall window, so its fraction counts, not only finished loads.
func swap_wait_progress() -> int:
	var total := _done_count * PROGRESS_SCALE
	var frac := []
	for path in _in_flight:
		if ResourceLoader.load_threaded_get_status(path, frac) == ResourceLoader.THREAD_LOAD_IN_PROGRESS:
			total += int(float(frac[0]) * PROGRESS_SCALE)
	return total


## Up to `n` of the zone's loaded materials and scenes not yet handed to the prewarm (ADR 0111 amendment 4).
func take_prewarm(n: int) -> Array[Resource]:
	var out: Array[Resource] = []
	while not _prewarm_queue.is_empty() and out.size() < n:
		out.append(_prewarm_queue.pop_front())
	return out


## True while a zone load is still coming in or a loaded one waits for the prewarm.
func prewarm_pending() -> bool:
	return not _prewarm_queue.is_empty() or not needed_ready()  # the other heroes never reach the prewarm


## True when every resident path is in.
func is_ready() -> bool:
	return pending.is_empty()


## True when every path the change in progress needs is in (the others may still load).
func needed_ready() -> bool:
	for path in pending:
		if _needed.has(path):
			return false
	return true


## `data` with every source kept to the party's own rows (party_only): the heroes a change needs now.
static func party_data(data: Dictionary) -> Dictionary:
	var out := data.duplicate(true)
	for src: Dictionary in out.get("sources", []):
		src["party_only"] = true
	return out


## Holds the parent router's swap until the needed loads are in (a no-op when none are pending).
func hold() -> void:
	var router := get_parent()
	if needed_ready() or holding or router == null or not router.has_method(&"hold_swap"):
		return
	router.call(&"hold_swap", self)
	holding = true


## Advances the loads: keeps each finished one, drops a failed one, and releases the hold when all are in.
func poll() -> void:
	for path in _in_flight.duplicate():
		var status := ResourceLoader.load_threaded_get_status(path)
		if status == ResourceLoader.THREAD_LOAD_LOADED:
			var res := ResourceLoader.load_threaded_get(path)
			if _scene_wanted.has(path) and not _resident_wanted.has(path):
				scene[path] = res
				if res is Material or res is PackedScene:
					_prewarm_queue.append(res)
			else:
				resident[path] = res
			_done_with(path)
		elif status == ResourceLoader.THREAD_LOAD_FAILED or status == ResourceLoader.THREAD_LOAD_INVALID_RESOURCE:
			push_warning("ResidentLoads: could not load %s" % path)
			_done_with(path)
	_pump()
	if needed_ready():
		_release()
	if pending.is_empty():
		set_process(false)


func _process(_delta: float) -> void:
	poll()


func _on_change_started(scene_path: String) -> void:
	if DisplayServer.get_name() == "headless" and not run_headless:
		return
	warm()
	load_scene(scene_path)
	if not (_data.get("no_hold_scenes", []) as Array).has(scene_path):
		hold()


## Requests queued paths until max_in_flight are loading at once (many concurrent threaded loads of zone
## resources crashed Godot 4.6.3: ADR 0029, and this class's own tests at 300 at once).
func _pump() -> void:
	var cap := maxi(int(_data.get("max_in_flight", 1)), 1)
	var order := PackedStringArray()  # what the change needs first
	for path in pending:
		if _needed.has(path):
			order.append(path)
	var router := get_parent()
	var changing := router != null and router.has_method(&"is_busy") and bool(router.call(&"is_busy"))
	for path in pending:
		if not _needed.has(path) and not changing:  # the rest wait until the change is over (they slowed its
			order.append(path)  # instantiate fivefold, 1.9 -> 10 s, sharing the loader with it)
	for path in order:
		if _in_flight.size() >= cap:
			break
		if _in_flight.has(path):
			continue
		if ResourceLoader.load_threaded_request(path) == OK:
			_in_flight.append(path)
		else:
			push_warning("ResidentLoads: could not request %s" % path)
			_done_with(path)
			_pump()
			return
	set_process(not pending.is_empty())


func _done_with(path: String) -> void:
	_done_count += 1
	if pending.has(path):
		pending.remove_at(pending.find(path))
	if _in_flight.has(path):
		_in_flight.remove_at(_in_flight.find(path))


func _ensure_data() -> void:
	if _data.is_empty():
		_data = load_data()
	if _scene_loads.is_empty():
		var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(SCENE_LOADS_PATH))
		if parsed is Dictionary:
			_scene_loads = ((parsed as Dictionary).get("scene_loads", {}) as Dictionary).get("scenes", {}) as Dictionary


func _release() -> void:
	if holding and get_parent() != null and get_parent().has_method(&"release_swap"):
		get_parent().call(&"release_swap", self)
	holding = false


func _exit_tree() -> void:
	_release()
