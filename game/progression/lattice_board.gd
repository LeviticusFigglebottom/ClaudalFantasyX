class_name LatticeBoard
extends RefCounted
## A Lattice board as an undirected graph (SPEC §6.4): nodes, adjacency, starts, and path
## queries. Pure data, headless. Source: game/data/progression/lattice_<id>.json, generated by
## tools/lattice_editor/ and checked by tools/validate_data.py.

const DATA_DIR := "res://game/data/progression"
const DEFAULT_BOARD := &"standard"

var id: StringName = &""
var name_key: String = ""
## Node id -> LatticeNode, in file order.
var nodes: Dictionary = {}
## Node id -> Array[StringName] of neighbours, in edge order (deterministic).
var _adjacency: Dictionary = {}
## Character id -> start node id.
var _starts: Dictionary = {}
var _edge_count := 0


static func path_for(board_id: StringName) -> String:
	return "%s/lattice_%s.json" % [DATA_DIR, board_id]


static func load_board(board_id: StringName = DEFAULT_BOARD) -> LatticeBoard:
	var path := path_for(board_id)
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(path))
	if typeof(parsed) != TYPE_DICTIONARY:
		push_error("LatticeBoard: could not parse %s" % path)
		return LatticeBoard.new()
	return from_dict(parsed as Dictionary)


## Builds a board from {"board": {id, name_key}, "nodes": [...], "edges": [[a, b], ...]}.
## Tests use this to inject small fixtures.
static func from_dict(d: Dictionary) -> LatticeBoard:
	var b := LatticeBoard.new()
	var meta: Dictionary = d.get("board", {})
	b.id = StringName(str(meta.get("id", "")))
	b.name_key = str(meta.get("name_key", ""))
	for row: Variant in d.get("nodes", []):
		var n := LatticeNode.from_dict(row as Dictionary)
		b.nodes[n.id] = n
		var empty: Array[StringName] = []
		b._adjacency[n.id] = empty
		if n.kind == LatticeNode.KIND_START:
			b._starts[n.character] = n.id
	for e: Variant in d.get("edges", []):
		var pair: Array = e
		var a := StringName(str(pair[0]))
		var c := StringName(str(pair[1]))
		if not b.nodes.has(a) or not b.nodes.has(c):
			push_error("LatticeBoard: dangling edge [%s, %s]" % [a, c])
			continue
		(b._adjacency[a] as Array[StringName]).append(c)
		(b._adjacency[c] as Array[StringName]).append(a)
		b._edge_count += 1
	return b


func has_lattice_node(node_id: StringName) -> bool:
	return nodes.has(node_id)


## Returns the node, or null if the id is unknown.
func lattice_node(node_id: StringName) -> LatticeNode:
	return nodes.get(node_id) as LatticeNode


func neighbors(node_id: StringName) -> Array[StringName]:
	var out: Array[StringName] = []
	if _adjacency.has(node_id):
		out.assign(_adjacency[node_id])
	return out


func are_adjacent(a: StringName, b: StringName) -> bool:
	return _adjacency.has(a) and (_adjacency[a] as Array[StringName]).has(b)


## The start node id for a character, or &"" if the board has none for them.
func start_of(character_id: StringName) -> StringName:
	return _starts.get(character_id, &"")


func node_count() -> int:
	return nodes.size()


func edge_count() -> int:
	return _edge_count


## Fewest-hops path from `from` to `to`, inclusive of both ends; [] if unreachable.
## `blocked` is a set (id -> true) of nodes that may not be entered (e.g. closed gates).
func shortest_path(from: StringName, to: StringName, blocked: Dictionary = {}) -> Array[StringName]:
	var out: Array[StringName] = []
	if not nodes.has(from) or not nodes.has(to):
		return out
	var came: Dictionary = {from: from}
	var queue: Array[StringName] = [from]
	var head := 0
	while head < queue.size():
		var cur := queue[head]
		head += 1
		if cur == to:
			break
		for nb in neighbors(cur):
			if not came.has(nb) and not blocked.has(nb):
				came[nb] = cur
				queue.append(nb)
	if not came.has(to):
		return out
	var step := to
	while step != from:
		out.push_front(step)
		step = came[step]
	out.push_front(from)
	return out


## Every node reachable from `from` without entering `blocked` nodes (set id -> true).
func reachable_from(from: StringName, blocked: Dictionary = {}) -> Dictionary:
	var seen: Dictionary = {}
	if not nodes.has(from):
		return seen
	seen[from] = true
	var stack: Array[StringName] = [from]
	while not stack.is_empty():
		var cur: StringName = stack.pop_back()
		for nb in neighbors(cur):
			if not seen.has(nb) and not blocked.has(nb):
				seen[nb] = true
				stack.append(nb)
	return seen
