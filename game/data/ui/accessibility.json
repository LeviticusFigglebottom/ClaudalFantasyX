    "battle_speed": {
      "doc": "M2-UI-23: battle_speed options are presentation speed multipliers (the same id and values as M2-BPR-03's BattleChoreo speed). Every battle presentation duration is divided by the speed (UiSettings.battle_time_scale): the controller's pacing waits, damage numbers and float words, the camera shake and the hit recoil. Never the engine, never a Swell input window (those stay real time).",
      "min": 0.5, "max": 2.0
    },
    "summon_cinematics": {
      "doc": "M2-UI-23: summon_cinematic option -> the cut of a Vowbound's call cinematic (SPEC 6.3: full on first use, then shortened, with a skip toggle), for the first call of that Vowbound and for every later call. full = every beat, short = the cinematic's middle beats skipped, none = straight to the effect. UiSettings.summon_cinematic_cut(first_call) answers it; the cinematic itself is M2-BPR-08's C10 BattleSummonCinematic (a full cut plays it, a short or none cut plays the short entry, choreo.json vowbound.entry). The default, short, plays a Vowbound's first call in full.",
      "full": {"first": "full", "again": "full"},
      "short": {"first": "full", "again": "short"},
      "off": {"first": "none", "again": "none"}
    },
    "text_speeds": {
      "doc": "M2-UI-12: text_speed option -> multiplier of the dialogue box's default chars_per_sec (text_box.json), clamped to its min/max; 0 = instant (the box shows the whole line at once).",
      "slow": 0.6, "normal": 1.0, "fast": 1.8, "instant": 0.0
    },
    "dialogue_backings": {
      "doc": "M2-UI-12: dialogue_backing option -> the alpha of the panel_low band behind dialogue and cutscene lines (0 = none).",
      "off": 0.0, "soft": 0.45, "solid": 0.85
    },
    "palettes": {
      "standard": {},
      "colorblind": {"danger": ["#C76E10", 1.0], "enemy_chip": ["#2A2414", 0.85]}
    },
    "timing_assist": {
      "doc": "M2-UI-01: what each timing_assist option does to a Swell input row (swell.json inputs, every kind) before the input is built. window_scale widens the windows, clamped per kind so the row still passes validate_data (max_duration_sec is its longest input, edge_margin_sec keeps the brace's counter window clear of the last blow); assist_floor is the quality a miss is recorded at (SwellInput._record); assist_hold (M2-UI-14, 'hold') applies that floor only while Confirm is held, so holding Confirm plays the input by itself; tag_key is the short tag the input panel shows while the assist is on. Numbers: docs/kb/design/formulas.md section Swell, Timing assist.",
      "off": {},
      "wide": {"window_scale": 1.5, "tag_key": "HUD_SWELL_ASSIST_WIDE"},
      "auto": {"assist_floor": "good", "tag_key": "HUD_SWELL_ASSIST_AUTO"},
      "hold": {"assist_floor": "good", "assist_hold": true, "tag_key": "HUD_SWELL_ASSIST_HOLD"},
      "max_duration_sec": 5.0,
      "edge_margin_sec": 0.01
    },
