{
  "theme": {
    "doc": "docs/kb/art/ui.md (art rules) and docs/kb/tech/ui.md (how this file becomes hymn_theme.tres).",
    "palette_path": "res://docs/kb/art/palette.json",
    "output_path": "res://game/ui/theme/hymn_theme.tres",
    "palette_type": "Hymn",
    "colors": {
      "panel_deep": ["ui_panel_deep", 0.80],
      "panel_low": ["ui_panel_low", 0.86],
      "panel_raised": ["ui_panel_raised", 0.85],
      "panel_sheen": ["ui_panel_raised", 0.25],
      "line_gold": ["ui_line_gold", 0.85],
      "focus_gold": ["ui_line_gold", 1.0],
      "rule_white": ["ui_line_white", 0.18],
      "separator_white": ["ui_line_white", 0.10],
      "gauge_border": ["ui_line_white", 0.35],
      "gauge_back": ["night_sky", 0.55],
      "text": ["ui_line_white", 1.0],
      "text_dim": ["ui_text_dim", 1.0],
      "text_disabled": ["ui_text_dim", 0.5],
      "focus": ["ui_focus", 0.9],
      "focus_glow": ["ui_focus", 0.35],
      "lamp_node_glow": ["ui_line_gold", 0.3],
      "hp": ["ui_hp", 1.0],
      "mp": ["ui_mp", 1.0],
      "swell": ["ui_swell", 1.0],
      "danger": ["ui_danger", 1.0],
      "heal": ["ui_heal", 1.0],
      "shadow": ["night_sky", 0.6],
      "outline": ["night_sky", 1.0],
      "enemy_chip": ["#2A1420", 0.85],
      "ally_chip": ["ui_panel_raised", 0.85],
      "scrim": ["night_sky", 0.55]
    },
    "constants": {
      "line_px": 1,
      "focus_px": 2,
      "focus_glow_px": 6,
      "inner_rule_inset_px": 3,
      "chamfer_px": 10,
      "chamfer_small_px": 6,
      "small_panel_max_height_px": 160,
      "lamp_node_px": 3,
      "lamp_node_glow_px": 4,
      "sheen_px": 24,
      "shadow_offset_y_px": 2,
      "shadow_blur_px": 4,
      "damage_outline_px": 4,
      "scroll_px": 6,
      "panel_margin_px": 20
    },
    "fonts": {
      "sans": "res://assets/fonts/source_sans_3/SourceSans3-Regular.otf",
      "sans_medium": "res://assets/fonts/source_sans_3/SourceSans3-Medium.otf",
      "sans_semibold": "res://assets/fonts/source_sans_3/SourceSans3-Semibold.otf",
      "sans_bold": "res://assets/fonts/source_sans_3/SourceSans3-Bold.otf",
      "sans_italic": "res://assets/fonts/source_sans_3/SourceSans3-It.otf",
      "serif": "res://assets/fonts/eb_garamond/EBGaramond12-Regular.otf",
      "serif_italic": "res://assets/fonts/eb_garamond/EBGaramond12-Italic.otf"
    },
    "serif_semibold_embolden": 0.45,
    "default_font": "sans",
    "default_font_size": 26,
    "variations": {
      "TitleLabel": {"base": "Label", "font": "serif", "size": 72, "spacing_glyph": 1},
      "BannerLabel": {"base": "Label", "font": "serif", "size": 40, "small_caps": true, "spacing_glyph": 3},
      "HeaderLabel": {"base": "Label", "font": "serif", "size": 28, "small_caps": true, "semibold": true,
                      "spacing_glyph": 2},
      "BodyLabel": {"base": "Label", "font": "sans", "size": 30},
      "MenuLabel": {"base": "Label", "font": "sans_medium", "size": 26},
      "HudName": {"base": "Label", "font": "sans_medium", "size": 24},
      "HudNumber": {"base": "Label", "font": "sans_semibold", "size": 24, "tabular": true},
      "SmallLabel": {"base": "Label", "font": "sans_medium", "size": 22},
      "RankLabel": {"base": "Label", "font": "sans_bold", "size": 22, "tabular": true, "spacing_glyph": 1},
      "HelpLabel": {"base": "Label", "font": "sans", "size": 24},
      "FlavorLabel": {"base": "Label", "font": "sans_italic", "size": 24},
      "DimLabel": {"base": "Label", "font": "sans_medium", "size": 22, "color": "text_dim"},
      "DamageNumber": {"base": "Label", "font": "sans_bold", "size": 44, "tabular": true, "outline": true},
      "DamageNumberCrit": {"base": "Label", "font": "sans_bold", "size": 56, "tabular": true, "outline": true},
      "CommandButton": {"base": "Button", "font": "sans_medium", "size": 26},
      "PanelSmall": {"base": "PanelContainer", "chamfer": "chamfer_small_px"}
    }
  }
}
