{
  "_doc": "Battle creature actors (M2-CRE-03, docs/kb/art/creatures/pipeline.md). Presentation only: no combat numbers. enemies.json `model` names a row's `scene`; BattleStage turns it into the FighterStandIn spec's `scene` (the M2-UI-07 hook) and merges `stand_in`. CreatureActor reads the rest: which clip an action plays (clip_by_skill, else clip_by_kind by the skill's kind), which clips loop, the KO fade, the boss's phases and breakable parts.",
  "defaults": {
    "idle": "idle",
    "hit": "hit",
    "ko": "ko",
    "loop": ["idle"],
    "blend_sec": 0.12,
    "clip_by_kind": {"physical": "attack", "magical": "cast", "support": "cast", "heal": "cast"},
    "clip_by_skill": {},
    "ko_fade_sec": 0.6,
    "stand_in": {"yaw_deg": 90.0},
    "phases": {},
    "break_parts": {},
    "portrait": {"clip": "idle", "clip_time": 0.0, "yaw_deg": 30.0, "pitch_deg": 14.0, "fov_deg": 28.0, "margin": 0.85}
  },
  "creatures": {
    "spar_wraith": {"scene": "res://game/creatures/spar_wraith/spar_wraith_battle.tscn"},
    "sail_leech": {"scene": "res://game/creatures/sail_leech/sail_leech_battle.tscn"},
    "bottle_hermit": {"scene": "res://game/creatures/bottle_hermit/bottle_hermit_battle.tscn"},
    "wickfry": {"scene": "res://game/creatures/wickfry/wickfry_battle.tscn"},
    "oil_slug": {"scene": "res://game/creatures/oil_slug/oil_slug_battle.tscn"},
    "tower_limpet": {"scene": "res://game/creatures/tower_limpet/tower_limpet_battle.tscn"},
    "drownbell": {
      "scene": "res://game/creatures/drownbell/drownbell_battle.tscn",
      "loop": ["idle", "idle_flood"],
      "clip_by_skill": {"toll": "cast"},
      "ko_fade_sec": 1.2,
      "phases": {
        "flood": {"clip": "phase_change", "idle": "idle_flood", "offset_m": [0.0, -0.35, 0.0], "tilt_deg": [0.0, 0.0, -6.0], "sec": 2.4}
      },
      "break_parts": {"toll": {"whole": ["Rim"], "broken": ["RimBroken"]}}
    },
    "hullgnaw": {
      "scene": "res://game/creatures/hullgnaw/hullgnaw_battle.tscn",
      "ko_fade_sec": 0.8
    },
    "reef_crab": {
      "scene": "res://game/creatures/reef_crab/reef_crab_battle.tscn",
      "clip_by_skill": {"brine_spit": "cast"}
    },
    "lantern_eel": {
      "scene": "res://game/creatures/lantern_eel/lantern_eel_battle.tscn",
      "clip_by_skill": {"lure_glow": "cast"}
    },
    "spawn_polyp": {
      "scene": "res://game/creatures/spawn_polyp/spawn_polyp_battle.tscn"
    },
    "gull_harrier": {
      "scene": "res://game/creatures/gull_harrier/gull_harrier_battle.tscn",
      "stand_in": {"yaw_deg": 60.0}
    }
  }
}
