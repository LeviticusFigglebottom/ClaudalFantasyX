  "map": {
    "doc": "Lookup order for each hit of an action: skills[skill_id] or items[item_id] (played once per target), then by what the hit did: damage plays elements[the skill's element], an HP restore plays events.heal, added statuses play events.status, and a KO plays events.ko. The opening plays events.ambush / events.preemptive when the battle starts.",
    "elements": {
      "none": "hit_none",
      "fire": "hit_fire",
      "ice": "hit_ice",
      "lightning": "hit_lightning",
      "water": "hit_water",
      "holy": "hit_holy"
    },
    "skills": {
      "lamp_dive": "lamp_dive",
      "shallows_verse": "shallows_verse",
      "read": "read"
    },
    "items": {},
    "events": {
