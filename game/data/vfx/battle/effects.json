{
  "version": 1,
  "doc": "M2-RND-03 battle VFX library: effect definitions and what triggers them. BattleVfx (game/vfx/battle/battle_vfx.gd) listens to the engine and plays them; it never writes combat state. docs/kb/tech/battle_vfx.md. Colours are palette.json swatches (named in `swatches`, tested).",
  "anchor_heights": {
    "feet": 0.05,
    "chest": 0.6,
    "head": 1.0
  },
  "safety": {
    "doc": "Photosensitivity: every flash is capped at flash_max_alpha, and two flashes are at least flash_min_interval_s apart (at most 2 a second, under WCAG 2.3.1's 3). Flashes draw on a CanvasLayer below the HUD, so the timeline is never covered (pillar 4).",
    "flash_max_alpha": 0.3,
    "flash_min_interval_s": 0.5,
    "flash_layer": 0
  },
  "reduced_motion": {
    "doc": "UiSettings.reduced_motion(): fewer, slower particles, no turbulence, and a flash at a third of its alpha with a gentle ramp.",
    "particle_scale": 0.4,
    "velocity_scale": 0.5,
    "flash_alpha_scale": 0.33,
    "flash_min_ramp_s": 0.3
  },
