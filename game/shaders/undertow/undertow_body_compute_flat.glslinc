#define HYMN_UNDERTOW_LATTICE_GDSHADERINC

// ---- game/shaders/include/common.gdshaderinc ----
// Hymn of the Undertow: shared shader helpers (colour space, hashing, noise, curl noise).
// Conventions: game/shaders/README.md. Stage-agnostic: no built-ins, so spatial, canvas_item,
// particles, sky and fog shaders can all include it.
//   #include "res://game/shaders/include/common.gdshaderinc"

#ifndef HYMN_COMMON_GDSHADERINC
#define HYMN_COMMON_GDSHADERINC

// ---------------------------------------------------------------------------------------------
// Quality tiers. A variant shader defines HYMN_QUALITY before including this file; the default
// is HIGH. Compare with #if HYMN_QUALITY >= HYMN_QUALITY_HIGH.
// ---------------------------------------------------------------------------------------------
#define HYMN_QUALITY_LOW 0
#define HYMN_QUALITY_MEDIUM 1
#define HYMN_QUALITY_HIGH 2
#define HYMN_QUALITY_ULTRA 3
#ifndef HYMN_QUALITY
#define HYMN_QUALITY HYMN_QUALITY_HIGH
#endif

// Octave cap for every fBm loop (the octave count itself is a uniform/argument).
#if HYMN_QUALITY >= HYMN_QUALITY_HIGH
#define HYMN_FBM_MAX_OCTAVES 8
#else
#define HYMN_FBM_MAX_OCTAVES 4
#endif

#define HYMN_PI 3.14159265358979
#define HYMN_TAU 6.28318530717959
#define HYMN_EPSILON 1e-6

// ---------------------------------------------------------------------------------------------
// Colour space. All lighting math is in linear Rec.709/sRGB primaries.
// ---------------------------------------------------------------------------------------------
#define HYMN_REC709_LUMA vec3(0.2126, 0.7152, 0.0722)

float hymn_luminance(vec3 linear_rgb) {
	return dot(linear_rgb, HYMN_REC709_LUMA);
}

// IEC 61966-2-1 piecewise transfer functions (exact, not the 2.2 gamma approximation).
vec3 hymn_srgb_to_linear(vec3 srgb) {
	vec3 c = max(srgb, vec3(0.0));
	vec3 lo = c / 12.92;
	vec3 hi = pow((c + 0.055) / 1.055, vec3(2.4));
	return mix(lo, hi, step(vec3(0.04045), c));
}

vec3 hymn_linear_to_srgb(vec3 linear_rgb) {
	vec3 c = max(linear_rgb, vec3(0.0));
	vec3 lo = c * 12.92;
	vec3 hi = 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055;
	return mix(lo, hi, step(vec3(0.0031308), c));
}

// Pushes saturation away from (amount > 1) or towards (amount < 1) the pixel's own luminance.
vec3 hymn_saturate_color(vec3 linear_rgb, float amount) {
	return mix(vec3(hymn_luminance(linear_rgb)), linear_rgb, amount);
}

// HSV in [0,1] for all channels (branchless form).
vec3 hymn_rgb_to_hsv(vec3 c) {
	vec4 k = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
	vec4 p = mix(vec4(c.bg, k.wz), vec4(c.gb, k.xy), step(c.b, c.g));
	vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
	float d = q.x - min(q.w, q.y);
	return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + HYMN_EPSILON)), d / (q.x + HYMN_EPSILON), q.x);
}

vec3 hymn_hsv_to_rgb(vec3 hsv) {
	vec3 p = abs(fract(hsv.xxx + vec3(1.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0);
	return hsv.z * mix(vec3(1.0), clamp(p - 1.0, 0.0, 1.0), hsv.y);
}

// Oklab (perceptual; used for grading and gradient interpolation). Input/output are linear sRGB.
float hymn_cbrt(float x) {
	return sign(x) * pow(abs(x), 1.0 / 3.0);
}

vec3 hymn_linear_srgb_to_oklab(vec3 c) {
	float l = 0.4122214708 * c.r + 0.5363325363 * c.g + 0.0514459929 * c.b;
	float m = 0.2119034982 * c.r + 0.6806995451 * c.g + 0.1073969566 * c.b;
	float s = 0.0883024619 * c.r + 0.2817188376 * c.g + 0.6299787005 * c.b;
	l = hymn_cbrt(l);
	m = hymn_cbrt(m);
	s = hymn_cbrt(s);
	return vec3(
		0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
		1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
		0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s);
}

vec3 hymn_oklab_to_linear_srgb(vec3 lab) {
	float l = lab.x + 0.3963377774 * lab.y + 0.2158037573 * lab.z;
	float m = lab.x - 0.1055613458 * lab.y - 0.0638541728 * lab.z;
	float s = lab.x - 0.0894841775 * lab.y - 1.2914855480 * lab.z;
	l = l * l * l;
	m = m * m * m;
	s = s * s * s;
	return vec3(
		4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
		-1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
		-0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s);
}

// ---------------------------------------------------------------------------------------------
// Hashing: PCG2D / PCG3D integer hashes (Jarzynski & Olano 2020). Stable across GPUs, no sin().
// *_cell* functions hash integer lattice cells; *_bits* functions hash any float exactly.
// ---------------------------------------------------------------------------------------------
#define HYMN_PCG_MUL 1664525u
#define HYMN_PCG_INC 1013904223u
#define HYMN_UINT_TO_UNIT (1.0 / 4294967295.0)

uvec2 hymn_pcg2d(uvec2 v) {
	v = v * HYMN_PCG_MUL + HYMN_PCG_INC;
	v.x += v.y * HYMN_PCG_MUL;
	v.y += v.x * HYMN_PCG_MUL;
	v = v ^ (v >> 16u);
	v.x += v.y * HYMN_PCG_MUL;
	v.y += v.x * HYMN_PCG_MUL;
	v = v ^ (v >> 16u);
	return v;
}

uvec3 hymn_pcg3d(uvec3 v) {
	v = v * HYMN_PCG_MUL + HYMN_PCG_INC;
	v.x += v.y * v.z;
	v.y += v.z * v.x;
	v.z += v.x * v.y;
	v = v ^ (v >> 16u);
	v.x += v.y * v.z;
	v.y += v.z * v.x;
	v.z += v.x * v.y;
	return v;
}

// Cell hashes: `cell` should hold whole numbers (e.g. floor(p)). Results in [0, 1].
float hymn_hash_cell2(vec2 cell) {
	return float(hymn_pcg2d(uvec2(ivec2(cell))).x) * HYMN_UINT_TO_UNIT;
}

vec2 hymn_hash_cell22(vec2 cell) {
	return vec2(hymn_pcg2d(uvec2(ivec2(cell)))) * HYMN_UINT_TO_UNIT;
}

float hymn_hash_cell3(vec3 cell) {
	return float(hymn_pcg3d(uvec3(ivec3(cell))).x) * HYMN_UINT_TO_UNIT;
}

vec3 hymn_hash_cell33(vec3 cell) {
	return vec3(hymn_pcg3d(uvec3(ivec3(cell)))) * HYMN_UINT_TO_UNIT;
}

// Bit hashes: any float input (e.g. a per-particle seed or a world position). Results in [0, 1].
float hymn_hash12(vec2 p) {
	return float(hymn_pcg2d(floatBitsToUint(p)).x) * HYMN_UINT_TO_UNIT;
}

vec3 hymn_hash33(vec3 p) {
	return vec3(hymn_pcg3d(floatBitsToUint(p))) * HYMN_UINT_TO_UNIT;
}

// ---------------------------------------------------------------------------------------------
// Value noise with quintic interpolation and analytic derivatives. Range [0, 1].
// The *_d variants return vec3(value, d/dx, d/dy) or vec4(value, d/dx, d/dy, d/dz).
// ---------------------------------------------------------------------------------------------
vec3 hymn_value_noise2_d(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	vec2 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
	vec2 du = 30.0 * f * f * (f * (f - 2.0) + 1.0);
	float n00 = hymn_hash_cell2(i);
	float n10 = hymn_hash_cell2(i + vec2(1.0, 0.0));
	float n01 = hymn_hash_cell2(i + vec2(0.0, 1.0));
	float n11 = hymn_hash_cell2(i + vec2(1.0, 1.0));
	float k1 = n10 - n00;
	float k2 = n01 - n00;
	float k3 = n00 - n10 - n01 + n11;
	float value = n00 + k1 * u.x + k2 * u.y + k3 * u.x * u.y;
	return vec3(value, du * vec2(k1 + k3 * u.y, k2 + k3 * u.x));
}

float hymn_value_noise2(vec2 p) {
	return hymn_value_noise2_d(p).x;
}

vec4 hymn_value_noise3_d(vec3 p) {
	vec3 i = floor(p);
	vec3 f = fract(p);
	vec3 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
	vec3 du = 30.0 * f * f * (f * (f - 2.0) + 1.0);
	float n000 = hymn_hash_cell3(i);
	float n100 = hymn_hash_cell3(i + vec3(1.0, 0.0, 0.0));
	float n010 = hymn_hash_cell3(i + vec3(0.0, 1.0, 0.0));
	float n110 = hymn_hash_cell3(i + vec3(1.0, 1.0, 0.0));
	float n001 = hymn_hash_cell3(i + vec3(0.0, 0.0, 1.0));
	float n101 = hymn_hash_cell3(i + vec3(1.0, 0.0, 1.0));
	float n011 = hymn_hash_cell3(i + vec3(0.0, 1.0, 1.0));
	float n111 = hymn_hash_cell3(i + vec3(1.0, 1.0, 1.0));
	float k1 = n100 - n000;
	float k2 = n010 - n000;
	float k3 = n001 - n000;
	float k4 = n000 - n100 - n010 + n110;
	float k5 = n000 - n010 - n001 + n011;
	float k6 = n000 - n100 - n001 + n101;
	float k7 = -n000 + n100 + n010 - n110 + n001 - n101 - n011 + n111;
	float value = n000 + k1 * u.x + k2 * u.y + k3 * u.z + k4 * u.x * u.y + k5 * u.y * u.z + k6 * u.z * u.x
			+ k7 * u.x * u.y * u.z;
	vec3 grad = du * vec3(
			k1 + k4 * u.y + k6 * u.z + k7 * u.y * u.z,
			k2 + k5 * u.z + k4 * u.x + k7 * u.z * u.x,
			k3 + k6 * u.x + k5 * u.y + k7 * u.x * u.y);
	return vec4(value, grad);
}

float hymn_value_noise3(vec3 p) {
	return hymn_value_noise3_d(p).x;
}

// ---------------------------------------------------------------------------------------------
// fBm. Normalised to [0, 1] whatever the octave count. Each octave is rotated (2D) or offset (3D)
// to break lattice alignment. octaves is clamped to HYMN_FBM_MAX_OCTAVES for the active tier.
// Typical arguments: lacunarity 2.0, gain 0.5.
// ---------------------------------------------------------------------------------------------
#define HYMN_FBM_ROT2 mat2(vec2(0.8, 0.6), vec2(-0.6, 0.8))
#define HYMN_FBM_SHIFT3 vec3(17.13, 31.71, 47.37)

float hymn_fbm2(vec2 p, int octaves, float lacunarity, float gain) {
	float sum = 0.0;
	float amp = 1.0;
	float norm = 0.0;
	for (int o = 0; o < HYMN_FBM_MAX_OCTAVES; o++) {
		if (o >= octaves) {
			break;
		}
		sum += amp * hymn_value_noise2(p);
		norm += amp;
		p = HYMN_FBM_ROT2 * p * lacunarity;
		amp *= gain;
	}
	return sum / max(norm, HYMN_EPSILON);
}

float hymn_fbm3(vec3 p, int octaves, float lacunarity, float gain) {
	float sum = 0.0;
	float amp = 1.0;
	float norm = 0.0;
	for (int o = 0; o < HYMN_FBM_MAX_OCTAVES; o++) {
		if (o >= octaves) {
			break;
		}
		sum += amp * hymn_value_noise3(p);
		norm += amp;
		p = p * lacunarity + HYMN_FBM_SHIFT3;
		amp *= gain;
	}
	return sum / max(norm, HYMN_EPSILON);
}

// ---------------------------------------------------------------------------------------------
// Curl noise: divergence-free flow fields for glimmer motes, foam advection and storm wisps.
// 2D: rotate the gradient of one scalar potential. 3D: curl of a vector potential built from three
// decorrelated noise fields (offsets below). Magnitudes are unnormalised (roughly [-2, 2]).
// ---------------------------------------------------------------------------------------------
#define HYMN_CURL_OFFSET_B vec3(31.416, -47.853, 12.793)
#define HYMN_CURL_OFFSET_C vec3(-19.235, 7.719, 63.137)

vec2 hymn_curl_noise2(vec2 p) {
	vec2 g = hymn_value_noise2_d(p).yz;
	return vec2(g.y, -g.x);
}

vec3 hymn_curl_noise3(vec3 p) {
	vec3 ga = hymn_value_noise3_d(p).yzw;
	vec3 gb = hymn_value_noise3_d(p + HYMN_CURL_OFFSET_B).yzw;
	vec3 gc = hymn_value_noise3_d(p + HYMN_CURL_OFFSET_C).yzw;
	// psi = (a, b, c); curl psi = (dc/dy - db/dz, da/dz - dc/dx, db/dx - da/dy)
	return vec3(gc.y - gb.z, ga.z - gc.x, gb.x - ga.y);
}

// Multi-octave curl: each octave is divergence-free, so the weighted sum is too. Not normalised.
// (Octaves are not scaled by frequency, which keeps fine octaves from dominating the flow.)
vec3 hymn_curl_fbm3(vec3 p, int octaves, float lacunarity, float gain) {
	vec3 sum = vec3(0.0);
	float amp = 1.0;
	for (int o = 0; o < HYMN_FBM_MAX_OCTAVES; o++) {
		if (o >= octaves) {
			break;
		}
		sum += amp * hymn_curl_noise3(p);
		p = p * lacunarity + HYMN_FBM_SHIFT3;
		amp *= gain;
	}
	return sum;
}

#endif
// ---- end game/shaders/include/common.gdshaderinc ----

vec4 undertow_lattice(vec3 p) {
	vec3 i = floor(p);
	vec3 f = p - i;
	vec3 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
	return texture(noise_tex, (i + u + 0.5) / noise_texels);
}

float undertow_noise(vec3 p) {
	return undertow_lattice(p).r;
}

// The common include's striation warp fetches this lattice instead of hashing.
#define UNDERTOW_BAKED_NOISE

// hymn_fbm3 (lacunarity 2, gain 0.5) on the baked lattice.
float undertow_fbm(vec3 p, int octaves) {
	float sum = 0.0;
	float amp = 1.0;
	float norm = 0.0;
	for (int o = 0; o < HYMN_FBM_MAX_OCTAVES; o++) {
		if (o >= octaves) {
			break;
		}
		sum += amp * undertow_noise(p);
		norm += amp;
		p = p * 2.0 + HYMN_FBM_SHIFT3;
		amp *= 0.5;
	}
	return sum / max(norm, HYMN_EPSILON);
}

#endif
// ---- end game/shaders/undertow/undertow_lattice.gdshaderinc ----

// ---- game/shaders/undertow/undertow_common.gdshaderinc ----
// Hymn of the Undertow: the Undertow storm, shared storm-space maths (M1-RND-03, SPEC §8.2 item 9).
// Docs: docs/kb/tech/undertow.md. Tunables: game/data/vfx/undertow.json (UndertowStorm pushes them).
// Every storm shader (raymarched body, Low-tier shells, spray, sea funnel) includes this file, so the
// body, its shells and the sea agree on the shape, the rotation, the wounds and the lightning.
//
// Storm-local space: origin = the eye at sea level (storm_center), +Y up, metres. Nothing reads TIME:
// storm_time_s is the storm's own clock (UndertowStorm.time_s), so cutscenes can pause and scrub it.
// Light meaning (docs/kb/art/color_script.md rule 1): the wounds are spawn_wound rents; the light
// pooled inside them and the motes they shed are glimmer_held, and both sink (drift DOWN the wall).

#ifndef HYMN_UNDERTOW_COMMON_GDSHADERINC
#define HYMN_UNDERTOW_COMMON_GDSHADERINC

// ---- game/shaders/include/glimmer.gdshaderinc ----
// Hymn of the Undertow: glimmer helpers shared with other shader domains (M1-RND-02).
// Docs: docs/kb/tech/glimmer.md. Meaning rules: docs/kb/art/color_script.md, narrative light rule 3.
// Includes common.gdshaderinc itself. For hymn_sea_glow_global(), include globals.gdshaderinc FIRST:
//   #include "res://game/shaders/include/globals.gdshaderinc"   // optional, enables *_global helpers
//   #include "res://game/shaders/include/glimmer.gdshaderinc"
// Stage-agnostic except where noted: no built-ins are used.

#ifndef HYMN_GLIMMER_GDSHADERINC
#define HYMN_GLIMMER_GDSHADERINC


// ---------------------------------------------------------------------------------------------
// Palette (docs/kb/art/palette.json), linear sRGB. Motes take their colours from
// game/data/vfx/glimmer.json at runtime; these constants are for shaders that have no JSON path
// (water, storm, emissive props) and must match palette.json.
// ---------------------------------------------------------------------------------------------
#define HYMN_GLIMMER_LIFT vec3(1.0, 0.8148, 0.4793)       // glimmer_lift   #FFE9B8 (released)
#define HYMN_GLIMMER_LIFT_HI vec3(0.9047, 0.9387, 1.0)    // glimmer_lift_hi #F4F8FF
#define HYMN_GLIMMER_HELD vec3(0.2122, 0.5647, 0.6939)    // glimmer_held   #7FC6D9 (held)
#define HYMN_GLIMMER_BOUND vec3(0.0782, 0.4508, 0.4342)   // glimmer_bound  #4FB3B0 (machines)
#define HYMN_SEA_GLOW_COLOR vec3(0.0116, 0.147, 0.1878)   // sea_glow       #1C6B78

// ---------------------------------------------------------------------------------------------
// Night sea-glow (colour script rule 3): faint emission of a thousand years of anchored dead.
// Energy 0.04-0.15 while on, modulated by slow noise with a period of 8-20 s and +-25% amplitude.
// It is EXACTLY 0 only in ending_dock. Never drop it below the floor for performance.
// ---------------------------------------------------------------------------------------------
#define HYMN_SEA_GLOW_ENERGY_MIN 0.04        // rule 3 floor
#define HYMN_SEA_GLOW_ENERGY_MAX 0.15        // rule 3 ceiling
#define HYMN_SEA_GLOW_MOD_AMPLITUDE 0.25     // rule 3: +-25%
#define HYMN_SEA_GLOW_PERIOD_S 13.0          // rule 3: 8-20 s; noise correlation time
#define HYMN_SEA_GLOW_PATCH_M 7.0            // horizontal size of a brighter or dimmer patch
#define HYMN_SEA_GLOW_DETAIL_SCALE 3.1       // second octave, finer patches
#define HYMN_SEA_GLOW_DETAIL_WEIGHT 0.35
#define HYMN_SEA_GLOW_DETAIL_OFFSET vec3(41.7, -13.3, 7.9)
#define HYMN_SEA_GLOW_COLUMN_PER_M 0.45      // in-water column build-up (1 - exp(-k * metres))
#define HYMN_SEA_GLOW_COLUMN_GAIN 1.0        // a deep column at most doubles the surface glow

// Zone energy clamped to the rule-3 band; <= 0 turns the glow off (ending_dock). Not gated by the mote
// energy hymn_glimmer.a any more (M1-RND-08): zones author the two separately. The band floor is the
// rule-3 floor (0.04), not the night minimum (0.08), so the Ending's E4 0.07 / E5 0.06 pass through.
float hymn_sea_glow_energy(float zone_energy) {
	if (zone_energy <= 0.0) {
		return 0.0;
	}
	return clamp(zone_energy, HYMN_SEA_GLOW_ENERGY_MIN, HYMN_SEA_GLOW_ENERGY_MAX);
}

// Slow modulation in [1 - amplitude, 1 + amplitude] for a world position and a clock in seconds.
float hymn_sea_glow_modulation(vec3 world_pos, float time_s) {
	vec3 p = vec3(world_pos.xz / HYMN_SEA_GLOW_PATCH_M, time_s / HYMN_SEA_GLOW_PERIOD_S);
	float n = hymn_value_noise3(p) * (1.0 - HYMN_SEA_GLOW_DETAIL_WEIGHT)
			+ hymn_value_noise3(p * HYMN_SEA_GLOW_DETAIL_SCALE + HYMN_SEA_GLOW_DETAIL_OFFSET)
					* HYMN_SEA_GLOW_DETAIL_WEIGHT;
	return 1.0 + HYMN_SEA_GLOW_MOD_AMPLITUDE * (2.0 * n - 1.0);
}

// Linear-light emission to ADD to a water surface (EMISSION) or water-column colour.
//   world_pos : world-space point on the surface (only .xz and the clock drive the noise)
//   time_s    : a pausable clock in seconds (hymn_wind_time, or a cinematic uniform), not raw TIME
//   energy    : clamped energy, normally hymn_sea_glow_energy(hymn_sea_glow_zone(material_energy))
//   column_m  : metres of water the view ray travels below the surface (0 = surface only); a
//               deeper column glows up to (1 + HYMN_SEA_GLOW_COLUMN_GAIN) times brighter
// Cost: two 3D value-noise lookups (16 PCG3D hashes) and an exp. Returns vec3(0) when energy <= 0.
vec3 hymn_sea_glow(vec3 world_pos, float time_s, float energy, float column_m) {
	if (energy <= 0.0) {
		return vec3(0.0);
	}
	float column = 1.0 + HYMN_SEA_GLOW_COLUMN_GAIN * (1.0 - exp(-HYMN_SEA_GLOW_COLUMN_PER_M * max(column_m, 0.0)));
	return HYMN_SEA_GLOW_COLOR * energy * hymn_sea_glow_modulation(world_pos, time_s) * column;
}

#ifdef HYMN_GLOBALS_GDSHADERINC
// The zone energy a surface uses (M1-RND-15). hymn_zone_sea_glow:
//   < 0  the zone's hard off (GlimmerField.set_scene_sea_glow(0), ending_dock): 0 for EVERY surface,
//        whatever its material sets, so no stray material can light the Ending's dark sea;
//   = 0  the zone set nothing (project default, and the reset on every zone change): a material's own
//        energy (> 0) shows, else none;
//   > 0  the zone's energy; a material's own energy (> 0) overrides it for that surface.
float hymn_sea_glow_zone(float material_energy) {
	if (hymn_zone_sea_glow < 0.0) {
		return 0.0;
	}
	return material_energy > 0.0 ? material_energy : hymn_zone_sea_glow;
}

// Convenience form reading the project globals: energy = hymn_sea_glow_zone(), clock = hymn_wind_time.
vec3 hymn_sea_glow_global(vec3 world_pos, float material_energy, float column_m) {
	float energy = hymn_sea_glow_energy(hymn_sea_glow_zone(material_energy));
	return hymn_sea_glow(world_pos, hymn_wind_time, energy, column_m);
}
#endif

#endif
// ---- end game/shaders/include/glimmer.gdshaderinc ----

// Lightning sites pushed by UndertowStorm (= undertow.json lightning.sites, tested).
#define UNDERTOW_MAX_FLASHES 4
// Palette (docs/kb/art/palette.json), linear sRGB: spawn_wound #3FE0C8.
#define UNDERTOW_SPAWN_WOUND vec3(0.0497, 0.7454, 0.5776)
// Decorrelating offsets for the noise fields below (arbitrary, fixed: they only pick other noise).
#define UNDERTOW_WOUND_OFFSET vec3(13.7, -41.3, 27.1)
#define UNDERTOW_PRESENCE_OFFSET vec3(-71.9, 5.3, 33.8)
#define UNDERTOW_DETAIL_OFFSET vec3(5.17, 19.3, -8.71)
#define UNDERTOW_STRIATION_OFFSET vec3(-23.3, 11.9, 47.6)
// Second wound octave: frequency ratio and weight (a lacunarity just off 2 hides the lattice).
#define UNDERTOW_WOUND_LACUNARITY 2.03
#define UNDERTOW_WOUND_DETAIL 0.35
// Fraction of the presence noise used to fade a wound in (soft edge of a rent region).
#define UNDERTOW_PRESENCE_SOFT 0.18
// Radii are clamped to this fraction of the eye radius before 1/r maths (the axis is singular).
#define UNDERTOW_AXIS_GUARD 0.25

// The uniforms (undertow_common_uniforms.gdshaderinc); the compute body declares them in its UBO.
#ifndef UNDERTOW_COMPUTE
// ---- game/shaders/undertow/undertow_common_uniforms.gdshaderinc ----
// Hymn of the Undertow: the storm-wide uniforms of undertow_common.gdshaderinc (M1-RND-03), split out
// (M2-RND-01) so the compute body (undertow_body_compute.glsl) can declare the same names in its UBO
// instead. tools/gen_undertow_compute.py reads this file; regenerate after editing it.

#ifndef HYMN_UNDERTOW_COMMON_UNIFORMS_GDSHADERINC
#define HYMN_UNDERTOW_COMMON_UNIFORMS_GDSHADERINC

group_uniforms storm;
uniform vec3 storm_center = vec3(0.0);
// The storm clock (s). Driven by UndertowStorm, never by TIME.
uniform float storm_time_s = 0.0;
// 0 = asleep (the Calm), 1 = fully risen. Scales coverage and height.
uniform float storm_intensity : hint_range(0.0, 1.0) = 1.0;
// Angular speed at the eyewall (rad/s); it falls off outward as (eye / r)^rotation_falloff.
uniform float rotation_rad_s : hint_range(0.0, 0.2) = 0.012;
uniform float rotation_falloff : hint_range(0.0, 2.0) = 0.85;
// Two-phase advection period (s): differential rotation would wind the noise up without bound.
uniform float flow_cycle_s : hint_range(10.0, 7200.0) = 900.0;
uniform float updraft_m_s : hint_range(0.0, 60.0) = 9.0;

group_uniforms shape;
uniform float eye_radius_m : hint_range(50.0, 20000.0) = 1300.0;
// The eye widens upward like a stadium: radius at the top = eye_radius_m * eye_flare.
uniform float eye_flare : hint_range(1.0, 5.0) = 2.1;
uniform float eye_flare_power : hint_range(0.5, 4.0) = 1.6;
uniform float wall_thickness_m : hint_range(100.0, 20000.0) = 2700.0;
uniform float wall_taper : hint_range(0.0, 0.9) = 0.3;
uniform float wall_softness_m : hint_range(1.0, 5000.0) = 700.0;
uniform float height_m : hint_range(500.0, 30000.0) = 11500.0;
uniform float top_softness : hint_range(0.01, 0.5) = 0.12;
uniform float canopy_height_m : hint_range(0.0, 30000.0) = 8600.0;
uniform float canopy_thickness_m : hint_range(10.0, 10000.0) = 2600.0;
uniform float canopy_radius_m : hint_range(100.0, 40000.0) = 8800.0;
uniform float canopy_softness_m : hint_range(1.0, 10000.0) = 2400.0;
uniform float band_radius_m : hint_range(100.0, 40000.0) = 10500.0;
uniform float band_height_m : hint_range(10.0, 10000.0) = 3200.0;
uniform float band_arms : hint_range(0.0, 8.0) = 3.0;
// Log-spiral pitch of the rain bands: phase = theta + band_twist * ln(r / eye).
uniform float band_twist : hint_range(0.0, 8.0) = 2.6;
uniform float band_sharpness : hint_range(0.5, 8.0) = 2.2;
uniform float band_density : hint_range(0.0, 1.0) = 0.55;
// Fraction of its height a sleeping (intensity 0) storm keeps.
uniform float calm_shrink : hint_range(0.0, 1.0) = 0.55;
// The wall's foot (M2-RND-01): a skirt of lifted water and spray that flares out from the wall's base
// by skirt_reach_m at sea level and closes at skirt_height_m, so the wall stands in the sea instead
// of on a flat horizon. 0 = no skirt.
uniform float skirt_height_m : hint_range(0.0, 8000.0) = 0.0;
uniform float skirt_reach_m : hint_range(0.0, 20000.0) = 0.0;
// Envelope of the skirt (below 1 the cloud noise tears it into rags of spray and scud).
uniform float skirt_density : hint_range(0.0, 1.0) = 1.0;
// The rain bands are continuous (their troughs filled) within band_join_m of the wall, so the flank
// masses grow out of the wall instead of standing beside it. 0 = the plain spiral.
uniform float band_join_m : hint_range(0.0, 20000.0) = 0.0;
// Helical striations wound around the wall (the rotating "plates" that make a vortex read from the
// side): vertical spacing, number of helix starts, depth of the modulation and its sharpness.
uniform float striation_spacing_m : hint_range(10.0, 10000.0) = 1500.0;
uniform float striation_starts : hint_range(0.0, 8.0) = 2.0;
uniform float striation_strength : hint_range(0.0, 1.0) = 0.55;
uniform float striation_sharpness : hint_range(0.5, 8.0) = 1.6;
// Irregular striations (M2-RND-01): one low-frequency noise sample in the rotating frame bends the
// helix by up to striation_warp turns of phase and flattens it by up to striation_vary, so the plates
// read as torn fluid instead of a machined thread. Scale of that field in metres. 0, 0 = the pure helix.
uniform float striation_warp : hint_range(0.0, 2.0) = 0.0;
uniform float striation_vary : hint_range(0.0, 1.0) = 0.0;
uniform float striation_warp_scale_m : hint_range(100.0, 40000.0) = 5000.0;

group_uniforms wounds;
uniform float wound_intensity : hint_range(0.0, 4.0) = 1.0;
uniform float wound_scale_m : hint_range(10.0, 10000.0) = 1100.0;
uniform float wound_width : hint_range(0.005, 0.5) = 0.075;
uniform float wound_coverage : hint_range(0.0, 1.0) = 0.42;
// Depth of the skin on each wall face that the rents open in (m).
uniform float wound_skin_m : hint_range(10.0, 10000.0) = 900.0;
// Height window (fraction of the storm's height) the rents open in.
uniform float wound_height_min : hint_range(0.0, 1.0) = 0.15;
uniform float wound_height_max : hint_range(0.0, 1.0) = 0.85;
uniform float wound_presence_scale_m : hint_range(10.0, 40000.0) = 4200.0;
// Held light sinks: how far the seam pattern has slid DOWN the wall (m). UndertowState integrates
// wounds.sink_m_s over the storm clock, piecewise, so the Letting (unbinding, M2-RND-05) can reverse it
// without the pattern jumping. Negative = risen.
uniform float wound_drift_m = 0.0;
// Torn rents (M2-RND-05): around each seam's open core, a dark lip of torn cloud rent_lip_width seam
// widths wide (its lit colour darkened by rent_lip_dark), and a wider halo (rent_halo_width) where the
// light pouring out of the rent scatters in the cloud beside it (rent_halo_energy x the seam glow).
uniform float rent_lip_width : hint_range(1.0, 8.0) = 2.5;
uniform float rent_lip_dark : hint_range(0.0, 1.0) = 0.6;
uniform float rent_halo_width : hint_range(1.0, 16.0) = 6.0;
uniform float rent_halo_energy : hint_range(0.0, 4.0) = 0.35;
uniform vec3 col_wound : source_color = vec3(0.0497, 0.7454, 0.5776);
uniform vec3 col_held : source_color = vec3(0.2122, 0.5647, 0.6939);

group_uniforms lightning;
// xyz = storm-local position (already rotated with the wall), w = flash level (0 = dark).
uniform vec4 lightning_sites[UNDERTOW_MAX_FLASHES];
uniform float lightning_radius_m : hint_range(10.0, 20000.0) = 2100.0;
uniform vec3 col_lightning : source_color = vec3(0.552, 0.672, 1.0);
uniform float lightning_energy : hint_range(0.0, 64.0) = 2.6;
group_uniforms;

#endif
// ---- end game/shaders/undertow/undertow_common_uniforms.gdshaderinc ----
#endif

vec3 undertow_local(vec3 world_pos) {
	return world_pos - storm_center;
}

vec2 undertow_rotate(vec2 v, float angle) {
	float c = cos(angle);
	float s = sin(angle);
	return vec2(c * v.x - s * v.y, s * v.x + c * v.y);
}

// Height scale: a sleeping storm is lower (calm_shrink at intensity 0).
float undertow_height() {
	return height_m * mix(calm_shrink, 1.0, storm_intensity);
}

// Angular speed (rad/s) at radius r: differential rotation, fastest at the eyewall.
float undertow_omega(float r) {
	return rotation_rad_s * pow(eye_radius_m / max(r, eye_radius_m * UNDERTOW_AXIS_GUARD), rotation_falloff);
}

// Eye radius and outer wall radius at normalised height h in [0, 1].
float undertow_eye_r(float h) {
	return eye_radius_m * (1.0 + (eye_flare - 1.0) * pow(clamp(h, 0.0, 1.0), eye_flare_power));
}

float undertow_wall_r(float h) {
	return undertow_eye_r(h) + wall_thickness_m * (1.0 - wall_taper * clamp(h, 0.0, 1.0));
}

// Radius of the bounding cylinder every storm part fits in (the raymarch proxy uses it too).
float undertow_bound_r() {
	return max(max(canopy_radius_m, band_radius_m), undertow_wall_r(1.0) + wall_softness_m);
}

// Log-spiral phase of the inflow bands at a storm-local point (bands spiral IN toward the eye).
float undertow_spiral_phase(vec2 xz) {
	float r = max(length(xz), eye_radius_m * UNDERTOW_AXIS_GUARD);
	return atan(xz.y, xz.x) + band_twist * log(r / eye_radius_m);
}

// Helical striation in [0, 1] at p: bands that wind up the wall and turn with the eyewall (rigidly,
// so they never wind up). Phase = height / spacing + starts * angle / tau, bent by the warp field.
float undertow_striation(vec3 p) {
	float spin = -rotation_rad_s * storm_time_s;
	float a = atan(p.z, p.x) + spin;
	float phase = p.y / striation_spacing_m + striation_starts * a / HYMN_TAU;
	float depth = 1.0;
	if (striation_warp > 0.0 || striation_vary > 0.0) {
		// Sampled in the frame that turns with the eyewall, so the bends ride the helix.
		vec2 xz = undertow_rotate(p.xz, spin);
		vec3 q = vec3(xz.x, p.y, xz.y) / striation_warp_scale_m + UNDERTOW_STRIATION_OFFSET;
#ifdef UNDERTOW_BAKED_NOISE
		// The body's baked lattice: two decorrelated channels for one fetch.
		vec2 n = undertow_lattice(q).rg;
#else
		vec2 n = vec2(hymn_value_noise3(q), hymn_value_noise3(q + UNDERTOW_PRESENCE_OFFSET));
#endif
		phase += striation_warp * (2.0 * n.x - 1.0);
		depth = 1.0 - striation_vary * n.y;
	}
	return mix(1.0, pow(0.5 + 0.5 * cos(HYMN_TAU * phase), striation_sharpness), depth);
}

// Analytic coverage envelope parts in [0, 1] (no noise): x = the eyewall, y = the anvil canopy,
// z = the spiral rain bands. Cheap; the raymarch uses them for empty-space skipping and the wound
// mask, the shells for placement.
vec3 undertow_envelope_parts(vec3 p) {
	float H = undertow_height();
	float h = p.y / H;
	if (h <= 0.0 || h >= 1.0) {
		return vec3(0.0);
	}
	float r = length(p.xz);
	float ri = undertow_eye_r(h);
	float ro = undertow_wall_r(h);
	float wall = smoothstep(ri - wall_softness_m * 0.25, ri + wall_softness_m, r)
			* (1.0 - smoothstep(ro - wall_softness_m, ro + wall_softness_m, r));
	wall *= 1.0 - smoothstep(1.0 - top_softness, 1.0, h);
	if (wall > 0.0) {
		wall *= mix(1.0, undertow_striation(p), striation_strength);
	}
	if (skirt_height_m > 0.0) {
		float sh = clamp(p.y / skirt_height_m, 0.0, 1.0);
		float reach = ro + skirt_reach_m * (1.0 - sh) * (1.0 - sh);
		float skirt = (1.0 - smoothstep(0.55, 1.0, sh))
				* smoothstep(ri - wall_softness_m * 0.25, ri + wall_softness_m, r)
				* (1.0 - smoothstep(reach - wall_softness_m, reach + wall_softness_m, r));
		wall = max(wall, skirt * skirt_density);
	}
	float ch = canopy_height_m * H / height_m;
	float canopy = (1.0 - smoothstep(0.0, canopy_thickness_m * 0.5, abs(p.y - ch)))
			* (1.0 - smoothstep(canopy_radius_m - canopy_softness_m, canopy_radius_m, r))
			* smoothstep(ri, ri + wall_softness_m, r);
	float arm = pow(0.5 + 0.5 * cos(band_arms * undertow_spiral_phase(p.xz)), band_sharpness);
	if (band_join_m > 0.0) {
		arm = mix(1.0, arm, smoothstep(ro, ro + band_join_m, r));
	}
	float band = arm * band_density * (1.0 - smoothstep(0.0, band_height_m, p.y))
			* smoothstep(ro - wall_softness_m, ro + wall_softness_m, r)
			* (1.0 - smoothstep(band_radius_m * 0.55, band_radius_m, r));
	return vec3(wall, canopy, band) * smoothstep(0.0, 0.2, storm_intensity + 0.05);
}

float undertow_envelope(vec3 p) {
	vec3 e = undertow_envelope_parts(p);
	return max(max(e.x, e.y), e.z);
}

// Height window the rents open in (h = fraction of the storm's height).
float undertow_wound_band(float h) {
	return smoothstep(wound_height_min, wound_height_min + 0.1, h)
			* (1.0 - smoothstep(wound_height_max - 0.1, wound_height_max, h));
}

// 1 within wound_skin_m of the eyewall's two faces (the eye face and the outer face), else 0:
// where the rents open. Keeps the cylinder-mapped wound pattern off the wall's interior.
float undertow_wall_skin(vec3 p) {
	float h = clamp(p.y / undertow_height(), 0.0, 1.0);
	float r = length(p.xz);
	float d_in = abs(r - undertow_eye_r(h) - wall_softness_m * 0.5);
	float d_out = abs(r - undertow_wall_r(h) + wall_softness_m * 0.5);
	return (1.0 - smoothstep(0.5 * wound_skin_m, wound_skin_m, min(d_in, d_out))) * undertow_wound_band(h);
}

// Two-phase clocks for advection: sample at ta and tb, blend a with weight wa. Each phase resets
// while its weight is 0, so the differential rotation never winds the pattern up.
void undertow_phases(out float ta, out float tb, out float wa) {
	float fa = fract(storm_time_s / flow_cycle_s);
	float fb = fract(storm_time_s / flow_cycle_s + 0.5);
	ta = fa * flow_cycle_s;
	tb = fb * flow_cycle_s;
	wa = 1.0 - abs(2.0 * fa - 1.0);
}

// Where the fluid at p was `t` seconds ago (rotated back by omega(r) t, rising with the updraft).
vec3 undertow_flow_point(vec3 p, float t) {
	float r = length(p.xz);
	vec2 xz = undertow_rotate(p.xz, -undertow_omega(r) * t);
	return vec3(xz.x, p.y - updraft_m_s * t, xz.y);
}

// Glimmer wounds: thin seams (rents) on the wall where held light bleeds out, in regions picked by a
// low-frequency presence field. They ride the eyewall rotation and slide DOWN (held light sinks).
// Returns the seam strength in [0, 1]; `pocket` gets the presence (held light pooled behind it).
// M2-RND-05, torn rents: `lip` is the dark torn edge around the open core and `halo` the wider band
// where the light pouring out scatters in the cloud beside it (both 0 on the core itself).
float undertow_wound(vec3 p, out float pocket, out float lip, out float halo) {
	float t = storm_time_s;
	// Sampled on a fixed-radius cylinder (angle around the storm, height), so a seam is constant
	// through the wall's depth: a slit through the wall, not a 3D sparkle a raymarch would alias.
	float a = atan(p.z, p.x) - rotation_rad_s * t;
	float y = p.y + wound_drift_m;
	// Mapped at mid-wall so seams keep their proportions on both faces.
	float map_r = eye_radius_m + 0.5 * wall_thickness_m;
	vec3 q = vec3(cos(a) * map_r, y, sin(a) * map_r) / wound_scale_m;
	float n = hymn_value_noise3(q + UNDERTOW_WOUND_OFFSET) * (1.0 - UNDERTOW_WOUND_DETAIL)
			+ hymn_value_noise3(q * UNDERTOW_WOUND_LACUNARITY) * UNDERTOW_WOUND_DETAIL;
	float ridge = 1.0 - abs(2.0 * n - 1.0);
	float seam = smoothstep(1.0 - wound_width, 1.0, ridge);
	float edge = 1.0 - seam;
	lip = smoothstep(1.0 - wound_width * rent_lip_width, 1.0 - wound_width, ridge) * edge;
	halo = smoothstep(1.0 - wound_width * rent_halo_width, 1.0 - wound_width, ridge) * edge;
	vec3 qp = vec3(cos(a) * map_r, y, sin(a) * map_r) / wound_presence_scale_m;
	float pres = hymn_value_noise3(qp + UNDERTOW_PRESENCE_OFFSET);
	pocket = smoothstep(1.0 - wound_coverage, 1.0 - wound_coverage + UNDERTOW_PRESENCE_SOFT, pres);
	lip *= pocket * min(wound_intensity, 1.0);
	halo *= pocket * wound_intensity;
	return seam * pocket * wound_intensity;
}

// Lightning-like inner glow at p (linear radiance, before density weighting).
vec3 undertow_lightning(vec3 p) {
	float g = 0.0;
	float inv_r2 = 1.0 / (lightning_radius_m * lightning_radius_m);
	for (int i = 0; i < UNDERTOW_MAX_FLASHES; i++) {
		vec4 s = lightning_sites[i];
		if (s.w > 0.0) {
			vec3 d = p - s.xyz;
			g += s.w * exp(-dot(d, d) * inv_r2);
		}
	}
	return col_lightning * lightning_energy * g;
}

#endif
// ---- end game/shaders/undertow/undertow_common.gdshaderinc ----

#ifndef UNDERTOW_MAX_STEPS
#define UNDERTOW_MAX_STEPS 48
#endif
#ifndef UNDERTOW_LIGHT_SAMPLES
#define UNDERTOW_LIGHT_SAMPLES 2
#endif
#ifndef UNDERTOW_LIGHT_NOISE
#define UNDERTOW_LIGHT_NOISE 1
#endif
#ifndef UNDERTOW_CURL
#define UNDERTOW_CURL 1
#endif
#ifndef UNDERTOW_OCTAVES
#define UNDERTOW_OCTAVES 4
#endif
#ifndef UNDERTOW_BILLOW_SHADE
#define UNDERTOW_BILLOW_SHADE 1
#endif

// Interleaved gradient noise (Jimenez 2014, "Next Generation Post Processing in Call of Duty"):
// a per-pixel ray offset that hides step banding and that TAA resolves.
#define UNDERTOW_IGN vec3(0.06711056, 0.00583715, 52.9829189)
// Reverse-Z: a depth of 0 is the sky (no opaque surface).
#define UNDERTOW_SKY_DEPTH 1e-7
#define UNDERTOW_FAR_M 1e9
// Stop marching once the ray is this opaque.
#define UNDERTOW_MIN_TRANSMITTANCE 0.015
// Skip shading where the envelope is below this (empty-space skipping).
#define UNDERTOW_MIN_ENVELOPE 0.002
// 1 / (4 pi): Henyey-Greenstein normalisation.
#define UNDERTOW_INV_4PI 0.0795775
// Iteration headroom over UNDERTOW_MAX_STEPS for the skin-refined steps (they spend less budget).
#define UNDERTOW_SKIN_LOOP 2
// Octave count at or below which cloud_noise() skips its detail octave.
#define UNDERTOW_LIGHT_OCTAVES 2
// Finite-difference step of the baked curl, in lattice cells.
#define UNDERTOW_CURL_H 0.125
// Decorrelates the billow field from the cloud and detail fields (arbitrary, fixed).
#define UNDERTOW_BILLOW_OFFSET vec3(-31.7, 8.9, 14.3)
// Mean of |2n - 1| over the quintic value-noise lattice (measured: 0.330 over 4e5 samples).
#define UNDERTOW_BILLOW_MEAN 0.33

// hymn_curl_noise3 on the baked lattice: the vector potential is the lattice's RGB (three decorrelated
// fields), its gradients forward differences (four fetches instead of three analytic-gradient lookups).
vec3 undertow_curl(vec3 p) {
	vec3 c = undertow_lattice(p).rgb;
	vec3 gx = (undertow_lattice(p + vec3(UNDERTOW_CURL_H, 0.0, 0.0)).rgb - c) / UNDERTOW_CURL_H;
	vec3 gy = (undertow_lattice(p + vec3(0.0, UNDERTOW_CURL_H, 0.0)).rgb - c) / UNDERTOW_CURL_H;
	vec3 gz = (undertow_lattice(p + vec3(0.0, 0.0, UNDERTOW_CURL_H)).rgb - c) / UNDERTOW_CURL_H;
	// psi = (r, g, b); curl psi = (db/dy - dg/dz, dr/dz - db/dx, dg/dx - dr/dy)
	return vec3(gy.b - gz.g, gz.r - gx.b, gx.g - gy.r);
}

float hg_phase(float cos_t, float g) {
	float g2 = g * g;
	return UNDERTOW_INV_4PI * (1.0 - g2) / pow(max(1.0 + g2 - 2.0 * g * cos_t, HYMN_EPSILON), 1.5);
}

// Ray (storm-local origin ro, unit direction rd) against the bounding cylinder and the
// [0, top] slab. Returns (t_near, t_far); t_near >= t_far means a miss.
vec2 bound_interval(vec3 ro, vec3 rd, float radius, float top) {
	float a = dot(rd.xz, rd.xz);
	float b = dot(ro.xz, rd.xz);
	float c = dot(ro.xz, ro.xz) - radius * radius;
	vec2 tc = vec2(-UNDERTOW_FAR_M, UNDERTOW_FAR_M);
	if (a > HYMN_EPSILON) {
		float disc = b * b - a * c;
		if (disc < 0.0) {
			return vec2(1.0, 0.0);
		}
		float s = sqrt(disc);
		tc = vec2((-b - s) / a, (-b + s) / a);
	} else if (c > 0.0) {
		return vec2(1.0, 0.0);
	}
	vec2 ty = vec2(-UNDERTOW_FAR_M, UNDERTOW_FAR_M);
	if (abs(rd.y) > HYMN_EPSILON) {
		float t0 = -ro.y / rd.y;
		float t1 = (top - ro.y) / rd.y;
		ty = vec2(min(t0, t1), max(t0, t1));
	} else if (ro.y < 0.0 || ro.y > top) {
		return vec2(1.0, 0.0);
	}
	return vec2(max(tc.x, ty.x), min(tc.y, ty.y));
}

// Density in [0, 1] from the envelope eroded by noise: the full envelope keeps everything but the
// noise troughs, a thin envelope only the crests (billows at the wall's surface, wisps outside).
float cloud_density(float env, float n) {
	return clamp((n + erosion_envelope * env - erosion_threshold - coverage_bias) * erosion_contrast, 0.0, 1.0);
}

// Cloud noise in [0, 1] at storm-local p, two-phase advected along the vortex flow. With the curl
// warp on, warp_a / warp_b carry the two phases' warp vectors between calls; they are recomputed only
// when fresh_warp is true (the march decides, see curl_reuse). env is the envelope at p (the billows
// grow on the cloud's eroding fringe); lean gets the billows' drop toward the sun L there (positive =
// the lump faces the sun), 0 elsewhere.
float cloud_noise(vec3 p, int octaves, bool fresh_warp, inout vec3 warp_a, inout vec3 warp_b, float env, vec3 L,
		out float lean) {
	lean = 0.0;
	float ta;
	float tb;
	float wa;
	undertow_phases(ta, tb, wa);
	vec3 pa = undertow_flow_point(p, ta);
	vec3 pb = undertow_flow_point(p, tb);
	if (scud_height_m > 0.0) {
		float squash = mix(scud_stretch, 1.0, smoothstep(scud_height_m * 0.5, scud_height_m, p.y));
		pa.y *= squash;
		pb.y *= squash;
	}
#if UNDERTOW_CURL
	// Turbulence: a divergence-free warp carried with the flow (common.gdshaderinc curl noise).
	if (fresh_warp) {
		warp_a = undertow_curl(pa / curl_scale_m) * curl_warp_m;
		warp_b = undertow_curl(pb / curl_scale_m + HYMN_CURL_OFFSET_B) * curl_warp_m;
	}
	pa += warp_a;
	pb += warp_b;
#endif
	float na = undertow_fbm(pa / noise_scale_m, octaves);
	float nb = undertow_fbm(pb / noise_scale_m, octaves);
	float n = mix(nb, na, wa);
	if (octaves > UNDERTOW_LIGHT_OCTAVES) {
		float da = undertow_noise(pa / detail_scale_m + UNDERTOW_DETAIL_OFFSET);
		float db = undertow_noise(pb / detail_scale_m + UNDERTOW_DETAIL_OFFSET);
		n = mix(n, mix(db, da, wa), detail_weight);
	}
	// The fringe: cloud that is there but not yet solid (density in (0, 1)). The billows reshape its
	// middle, 4 d0 (1 - d0): never the solid core, and never the outermost wisps, which carving would cut
	// loose into floating islands (seen on undertow_horizon_dusk). Nothing to do in empty steps.
	float d0 = billow_weight > 0.0 ? cloud_density(env, n) : 0.0;
	float surface = 4.0 * d0 * (1.0 - d0);
	if (surface > 0.0) {
		float ba = undertow_noise(pa / billow_scale_m + UNDERTOW_BILLOW_OFFSET);
		float bb = undertow_noise(pb / billow_scale_m + UNDERTOW_BILLOW_OFFSET);
		float billow = abs(2.0 * mix(bb, ba, wa) - 1.0);
		// Zero-mean, so the lumps reshape the fringe without thinning the storm's coverage.
		n += billow_weight * surface * (billow - UNDERTOW_BILLOW_MEAN);
#if UNDERTOW_BILLOW_SHADE
		if (billow_shade > 0.0) {
			vec3 step_l = L * billow_shade_step_m;
			float la = undertow_noise((pa + step_l) / billow_scale_m + UNDERTOW_BILLOW_OFFSET);
			float lb = undertow_noise((pb + step_l) / billow_scale_m + UNDERTOW_BILLOW_OFFSET);
			// The lump here minus the lump one step toward the sun (through the same fold).
			lean = (billow - abs(2.0 * mix(lb, la, wa) - 1.0)) * surface;
		}
#endif
	}
	return n;
}

// Coarse two-phase noise for the sun-ward light samples: one octave, no curl warp. Shadows only need
// the billows' large shape, and these samples are the inner loop's inner loop.
float cloud_noise_coarse(vec3 p) {
	float ta;
	float tb;
	float wa;
	undertow_phases(ta, tb, wa);
	float na = undertow_noise(undertow_flow_point(p, ta) / noise_scale_m);
	float nb = undertow_noise(undertow_flow_point(p, tb) / noise_scale_m);
	return mix(nb, na, wa);
}

// Sun-ward optical depth at p (extinction units: transmittance = exp(-it)).
float sun_optical_depth(vec3 p, vec3 L) {
	float od = 0.0;
	for (int k = 1; k <= UNDERTOW_LIGHT_SAMPLES; k++) {
		vec3 q = p + L * (light_step_m * float(k * k));
		float e = undertow_envelope(q);
#if UNDERTOW_LIGHT_NOISE
		float d = e > UNDERTOW_MIN_ENVELOPE ? cloud_density(e, cloud_noise_coarse(q)) : 0.0;
#else
		float d = e * e;
#endif
		od += d * light_step_m * float(2 * k - 1);
	}
	return od * density_per_m * sun_extinction;
}

// The body's march along one view ray (storm-local origin ro, unit direction rd), clipped to the opaque
// surface at distance t_opaque (UNDERTOW_FAR_M: none); frag_coord (pixels) picks the jitter. Returns the
// premultiplied colour (haze applied) and alpha, or alpha < 0 where the ray misses the storm. t_mean gets
// the mean distance of what the ray saw, weighted by opacity (UNDERTOW_FAR_M on a miss).
vec4 undertow_march(vec3 ro, vec3 rd, float t_opaque, vec2 frag_coord, out float t_mean) {
	float top = undertow_height();
	vec2 seg = bound_interval(ro, rd, undertow_bound_r() + bound_margin_m, top);
	float t0 = max(seg.x, 0.0);
	float t1 = min(seg.y, t_opaque);
	if (t1 <= t0) {
		t_mean = UNDERTOW_FAR_M;
		return vec4(-1.0);
	}
	int steps = clamp(march_steps, 1, UNDERTOW_MAX_STEPS);
	float dt = (t1 - t0) / float(steps);
	float ign = fract(UNDERTOW_IGN.z * fract(dot(frag_coord, UNDERTOW_IGN.xy)));
	float offset = mix(0.5, fract(ign + jitter_phase), jitter);
	vec3 L = normalize(hymn_sun_direction + vec3(0.0, HYMN_EPSILON, 0.0));
	float cos_t = dot(rd, L);
	float phase = mix(hg_phase(cos_t, back_scatter), hg_phase(cos_t, forward_scatter), scatter_mix);
	// Per-octave energy x phase (cos_t is per pixel, so the octaves' phases are computed once here).
	vec4 ms_weight = vec4(0.0);
	float ms_a = 1.0;
	float ms_c = 1.0;
	for (int o = 0; o < 4; o++) {
		if (o >= ms_octaves) {
			break;
		}
		ms_weight[o] = ms_a * mix(hg_phase(cos_t, back_scatter * ms_c), hg_phase(cos_t, forward_scatter * ms_c), scatter_mix);
		ms_a *= ms_attenuation;
		ms_c *= ms_eccentricity;
	}
	vec3 sun = col_sun * sun_energy;
	vec3 albedo = col_albedo * albedo_gain;
	float wound_per_m = wound_energy / wound_scale_m;
	vec3 sum = vec3(0.0);
	float T = 1.0;
	float t_weight = 0.0;
	float t_acc = 0.0;
	// Adaptive steps: long strides through empty envelope, short ones inside the cloud (a uniform
	// stride undersamples the billows and leaves streaks along the view rays).
	float t = t0 + offset * dt * dense_step;
	vec3 warp_a = vec3(0.0);
	vec3 warp_b = vec3(0.0);
	// Dense steps since the warp was computed; an empty stride forces a fresh one.
	int warp_age = curl_reuse;
	// Step budget: a skin-refined step spends only its share of a full dense stride, so the refinement
	// never ends a ray before it crosses the wall (it did: see-through holes on undertow_horizon_dusk).
	float budget = 0.0;
	float dense_ds = dense_step * dt;
	for (int i = 0; i < UNDERTOW_MAX_STEPS * UNDERTOW_SKIN_LOOP; i++) {
		if (budget >= float(steps) || T < UNDERTOW_MIN_TRANSMITTANCE || t > t1) {
			break;
		}
		vec3 p = ro + rd * t;
		vec3 parts = undertow_envelope_parts(p);
		float env = max(max(parts.x, parts.y), parts.z);
		float ds = (env < UNDERTOW_MIN_ENVELOPE ? empty_step : dense_step) * dt;
		// Wounds open in the skins of the eyewall only (the canopy and bands carry no rents).
		float skin = env < UNDERTOW_MIN_ENVELOPE ? 0.0 : undertow_wall_skin(p) * parts.x;
		if (skin > 0.0) {
			ds = min(ds, wound_skin_m * skin_step);
		}
		budget += skin > 0.0 ? min(ds / dense_ds, 1.0) : 1.0;
		ds = min(ds, t1 - t + HYMN_EPSILON);
		float t_here = t;
		t += ds;
		if (env < UNDERTOW_MIN_ENVELOPE) {
			warp_age = curl_reuse;
			continue;
		}
		bool fresh_warp = warp_age >= curl_reuse;
		warp_age = fresh_warp ? 1 : warp_age + 1;
		float lean;
		float d = cloud_density(env, cloud_noise(p, UNDERTOW_OCTAVES, fresh_warp, warp_a, warp_b, env, L, lean));
		// Nothing below draws where the cloud is eroded away (a rent only thins it further), so the
		// wound noise is only evaluated where there is cloud (M1-RND-10: same image, fewer hashes).
		if (d <= 0.0) {
			continue;
		}
		float pocket = 0.0;
		float seam = 0.0;
		float lip = 0.0;
		float halo = 0.0;
		if (skin > 0.0) {
			seam = undertow_wound(p, pocket, lip, halo) * skin;
			pocket *= skin;
			lip *= skin;
			halo *= skin;
		}
		// A rent: the wall is torn open along the seam, and the light behind it shows.
		d *= 1.0 - clamp(seam, 0.0, 1.0) * rent_depth;
		float h = p.y / top;
		if (d <= 0.0) {
			continue;
		}
		// The rent glows where the wall is: through its depth, strongest at mid density. Its halo is the
		// light poured out of it, scattered by the cloud beside the rent (so it needs density).
		vec3 glow = col_wound * wound_per_m * (seam * (0.3 + 2.8 * d * (1.0 - d)) + halo * rent_halo_energy * d);
		float sigma = d * density_per_m;
		float ts = exp(-sigma * ds);
		// A lump facing the sun has less of itself between p and the light (lean > 0), one facing away more.
		float tau_sun = max(sun_optical_depth(p, L) - billow_shade * lean, 0.0);
		// Sum of the octaves: transmittance exp(-tau b^i) weighted by energy x phase.
		float sun_ms = 0.0;
		float ms_b = 1.0;
		for (int o = 0; o < 4; o++) {
			if (o >= ms_octaves) {
				break;
			}
			sun_ms += ms_weight[o] * exp(-tau_sun * ms_b);
			ms_b *= ms_extinction;
		}
		vec3 amb = mix(col_ambient_bottom, col_ambient_top, smoothstep(0.0, 1.0, h)) * ambient_energy;
		amb *= exp(-ambient_occlusion * env * d);
		float base = mix(1.0 - base_darkening, 1.0, smoothstep(0.0, 0.45, h));
		float sun_reach = mix(sun_low_floor, 1.0, smoothstep(0.0, sun_clear_height, h));
		vec3 alb = albedo;
		if (water_wall_height_m > 0.0) {
			alb = mix(albedo, col_water_wall, water_wall_mix * (1.0 - smoothstep(0.0, water_wall_height_m, p.y)));
		}
		// The torn lip around a rent is dark: shredded cloud in the rent's own shadow (M2-RND-05).
		vec3 lit = alb * (sun * sun_ms * sun_reach * HYMN_TAU * 2.0 + amb) * base * (1.0 - rent_lip_dark * lip);
		// ...and a little thicker, torn cloud heaped at the edge.
		d = min(d * (1.0 + 0.5 * lip), 1.0);
		// Inner light: lightning in the wall and held light pooled behind the wounds.
		vec3 inner = undertow_lightning(p) + col_held * pocket * pocket_energy * wound_intensity * env;
		// The torn lip is dark through: the pooled light shows at the open core, not in the shredded edge.
		vec3 s = lit + inner * (0.35 + 0.65 * d) * (1.0 - rent_lip_dark * lip);
		sum += T * (s * (1.0 - ts) + glow * ds);
		t_acc += T * (1.0 - ts) * t_here;
		t_weight += T * (1.0 - ts);
		T *= ts;
	}
	float alpha = 1.0 - T;
	t_mean = t_weight > 0.0 ? t_acc / t_weight : t0;
	float haze = 1.0 - exp(-t_mean / haze_visibility_m);
	return vec4(mix(sum, col_haze * alpha, haze), alpha);
}

#endif
// ---- end game/shaders/undertow/undertow_body_march.gdshaderinc ----

void main() {
	ivec2 px = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = ivec2(view_out_size);
	if (px.x >= size.x || px.y >= size.y) {
		return;
	}
	vec2 uv = (vec2(px) + 0.5) / view_out_size;
	// The farthest opaque surface (reverse-Z: the smallest depth) over the full-resolution texels this
	// pixel covers: the march stops there, and the composite drops the pixels whose own surface is nearer
	// than what the storm shows (out_front), so occluder edges stay sharp at full resolution.
	vec2 ratio = view_depth_size / view_out_size;
	ivec2 last = ivec2(view_depth_size) - 1;
	ivec2 d0 = min(ivec2(floor(vec2(px) * ratio)), last);
	ivec2 d1 = clamp(ivec2(ceil(vec2(px + 1) * ratio)) - 1, d0, last);
	float depth = 1.0;
	for (int y = d0.y; y <= d1.y; y++) {
		for (int x = d0.x; x <= d1.x; x++) {
			depth = min(depth, texelFetch(depth_tex, ivec2(x, y), 0).r);
		}
	}
	vec2 ndc = uv * 2.0 - 1.0;
	float t_opaque = UNDERTOW_FAR_M;
	if (depth > UNDERTOW_SKY_DEPTH) {
		vec4 v = view_inv_projection * vec4(ndc, depth, 1.0);
		t_opaque = length(v.xyz / v.w);
	}
	// The view ray: any point on it (the near plane, reverse-Z depth 1) gives its direction.
	vec4 near_v = view_inv_projection * vec4(ndc, 1.0, 1.0);
	vec3 rd = normalize(mat3(view_camera) * (near_v.xyz / near_v.w));
	vec3 ro = undertow_local(view_camera[3].xyz);
	float t_mean;
	vec4 body = undertow_march(ro, rd, t_opaque, vec2(px) + 0.5, t_mean);
	if (body.a < 0.0) {
		body = vec4(0.0);
		t_mean = UNDERTOW_FAR_M;
	}
	imageStore(out_body, px, body);
	imageStore(out_front, px, vec4(t_mean, 0.0, 0.0, 0.0));
}
