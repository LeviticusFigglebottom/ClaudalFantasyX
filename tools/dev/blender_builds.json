{
  "_doc": "Blender asset builds re-verified by tools/dev/verify_blender_builds.py (M1-QA-02, ADR 0005). See docs/kb/qa/blender_builds.md.",
  "blender_version": "5.0.1",
  "blender_deb": "5.0.1+dfsg-5",
  "_threads": "M1-QA-06: Blender runs with --threads <n>, never the host's CPU count. A job that exports tangents runs single-threaded: Blender's threaded tangent export races (base_body differed run to run at 4 threads, and was stable at 1). Vegetation stopped exporting them (M1-ENV-07), so it is back at the default. Every other job is pinned at 4, the count its committed files were built with (Asha's body bakes change with the thread count). Verified on a 4-vCPU host only (M1-NIT-01). See docs/kb/qa/blender_builds.md.",
  "default_threads": 4,
  "copy_into_sandbox": ["assets_src"],
  "coverage_exempt": [],
  "jobs": [
    {
      "id": "base_body",
      "owner": "character",
      "sources": ["assets_src/characters/base_body/**", "assets_src/third_party/mpfb2/**"],
      "outputs": ["assets/characters/base_body/*.glb"],
      "threads": 1,
      "runs": [
        ["{blender}", "--python", "assets_src/characters/base_body/build.py", "--", "--variant", "slender", "--out", "assets/characters/base_body/base_body_slender.glb"],
        ["{blender}", "--python", "assets_src/characters/base_body/build.py", "--", "--variant", "athletic", "--out", "assets/characters/base_body/base_body_athletic.glb"],
        ["{blender}", "--python", "assets_src/characters/base_body/build.py", "--", "--variant", "heavy", "--out", "assets/characters/base_body/base_body_heavy.glb"]
      ]
    },
    {
      "id": "asha",
      "owner": "character",
      "sources": ["assets_src/characters/asha/**", "assets_src/characters/base_body/**", "assets_src/third_party/mpfb2/**"],
      "outputs": ["assets/characters/asha/*.glb", "assets/characters/asha/textures/*.png", "assets/characters/asha/materials/*.tres"],
      "runs": [
        ["{blender}", "--python", "assets_src/characters/asha/build_asha.py", "--", "--out", "assets/characters/asha/asha.glb", "--bake-dir", "{scratch}/asha_bake"],
        ["{python}", "assets_src/characters/asha/asha_textures.py", "--bake-dir", "{scratch}/asha_bake"],
        ["{python}", "assets_src/characters/asha/write_materials.py"]
      ]
    },
    {
      "id": "shader_test",
      "owner": "rendering",
      "sources": ["assets_src/characters/shader_test/build_shader_test_meshes.py", "assets_src/characters/shader_test/layout.py"],
      "outputs": ["assets/characters/shader_test/*.glb"],
      "runs": [
        ["{blender}", "--python", "assets_src/characters/shader_test/build_shader_test_meshes.py"]
      ]
    },
    {
      "id": "vegetation",
      "owner": "environment",
      "sources": ["assets_src/environments/vegetation/*.py"],
      "outputs": ["assets/environments/vegetation/*.glb"],
      "runs": [
        ["{blender}", "--python", "assets_src/environments/vegetation/build.py", "--", "--all", "--out-dir", "assets/environments/vegetation"]
      ]
    },
    {
      "id": "haluna_kit",
      "owner": "environment",
      "sources": ["assets_src/environments/kits/haluna/*.py"],
      "outputs": ["assets/environments/kits/haluna/*.glb", "assets/environments/kits/haluna/kit_manifest.json"],
      "runs": [
        ["{blender}", "--python", "assets_src/environments/kits/haluna/build.py", "--", "--all", "--out-dir", "assets/environments/kits/haluna", "--manifest", "assets/environments/kits/haluna/kit_manifest.json"]
      ]
    },
    {
      "id": "creature_reef_crab",
      "owner": "character",
      "sources": ["assets_src/creatures/reef_crab/**", "assets_src/creatures/common/**"],
      "outputs": ["assets/creatures/reef_crab/*.glb", "assets/creatures/reef_crab/materials/*.tres"],
      "runs": [
        ["{blender}", "--python", "assets_src/creatures/reef_crab/build_reef_crab.py", "--", "--out", "assets/creatures/reef_crab/reef_crab.glb"],
        ["{python}", "assets_src/creatures/common/write_materials.py", "--creature", "reef_crab"]
      ]
    },
    {
      "id": "creature_drownbell",
      "owner": "character",
      "sources": ["assets_src/creatures/drownbell/**", "assets_src/creatures/common/**"],
      "outputs": ["assets/creatures/drownbell/*.glb", "assets/creatures/drownbell/materials/*.tres"],
      "runs": [
        ["{blender}", "--python", "assets_src/creatures/drownbell/build_drownbell.py", "--", "--out", "assets/creatures/drownbell/drownbell.glb"],
        ["{python}", "assets_src/creatures/common/write_materials.py", "--creature", "drownbell"]
      ]
    },
    {
      "id": "creature_hullgnaw",
      "owner": "character",
      "sources": ["assets_src/creatures/hullgnaw/**", "assets_src/creatures/common/**"],
      "outputs": ["assets/creatures/hullgnaw/*.glb", "assets/creatures/hullgnaw/materials/*.tres"],
      "runs": [
        ["{blender}", "--python", "assets_src/creatures/hullgnaw/build_hullgnaw.py", "--", "--out", "assets/creatures/hullgnaw/hullgnaw.glb"],
        ["{python}", "assets_src/creatures/common/write_materials.py", "--creature", "hullgnaw"]
      ]
    },
    {
      "id": "creature_tower_limpet",
      "owner": "character",
      "sources": ["assets_src/creatures/tower_limpet/**", "assets_src/creatures/common/**"],
      "outputs": ["assets/creatures/tower_limpet/*.glb", "assets/creatures/tower_limpet/materials/*.tres"],
      "runs": [
        ["{blender}", "--python", "assets_src/creatures/tower_limpet/build_tower_limpet.py", "--", "--out", "assets/creatures/tower_limpet/tower_limpet.glb"],
        ["{python}", "assets_src/creatures/common/write_materials.py", "--creature", "tower_limpet"]
      ]
    },
    {
      "id": "creature_lantern_eel",
      "owner": "character",
      "sources": ["assets_src/creatures/lantern_eel/**", "assets_src/creatures/common/**"],
      "outputs": ["assets/creatures/lantern_eel/*.glb", "assets/creatures/lantern_eel/materials/*.tres"],
      "runs": [
        ["{blender}", "--python", "assets_src/creatures/lantern_eel/build_lantern_eel.py", "--", "--out", "assets/creatures/lantern_eel/lantern_eel.glb"],
        ["{python}", "assets_src/creatures/common/write_materials.py", "--creature", "lantern_eel"]
      ]
    },
    {
      "id": "creature_oil_slug",
      "owner": "character",
      "sources": ["assets_src/creatures/oil_slug/**", "assets_src/creatures/common/**"],
      "outputs": ["assets/creatures/oil_slug/*.glb", "assets/creatures/oil_slug/materials/*.tres"],
      "runs": [
        ["{blender}", "--python", "assets_src/creatures/oil_slug/build_oil_slug.py", "--", "--out", "assets/creatures/oil_slug/oil_slug.glb"],
        ["{python}", "assets_src/creatures/common/write_materials.py", "--creature", "oil_slug"]
      ]
    },
    {
      "id": "creature_spawn_polyp",
      "owner": "character",
      "sources": ["assets_src/creatures/spawn_polyp/**", "assets_src/creatures/common/**"],
      "outputs": ["assets/creatures/spawn_polyp/*.glb", "assets/creatures/spawn_polyp/materials/*.tres"],
      "runs": [
        ["{blender}", "--python", "assets_src/creatures/spawn_polyp/build_spawn_polyp.py", "--", "--out", "assets/creatures/spawn_polyp/spawn_polyp.glb"],
        ["{python}", "assets_src/creatures/common/write_materials.py", "--creature", "spawn_polyp"]
      ]
    },
    {
      "id": "creature_wickfry",
      "owner": "character",
      "sources": ["assets_src/creatures/wickfry/**", "assets_src/creatures/common/**"],
      "outputs": ["assets/creatures/wickfry/*.glb", "assets/creatures/wickfry/materials/*.tres"],
      "runs": [
        ["{blender}", "--python", "assets_src/creatures/wickfry/build_wickfry.py", "--", "--out", "assets/creatures/wickfry/wickfry.glb"],
        ["{python}", "assets_src/creatures/common/write_materials.py", "--creature", "wickfry"]
      ]
    },
    {
      "id": "creature_bottle_hermit",
      "owner": "character",
      "sources": ["assets_src/creatures/bottle_hermit/**", "assets_src/creatures/common/**"],
      "outputs": ["assets/creatures/bottle_hermit/*.glb", "assets/creatures/bottle_hermit/materials/*.tres"],
      "runs": [
        ["{blender}", "--python", "assets_src/creatures/bottle_hermit/build_bottle_hermit.py", "--", "--out", "assets/creatures/bottle_hermit/bottle_hermit.glb"],
        ["{python}", "assets_src/creatures/common/write_materials.py", "--creature", "bottle_hermit"]
      ]
    }
  ]
}
