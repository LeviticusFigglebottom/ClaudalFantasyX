{
  "_doc": "Blender asset builds re-verified by tools/dev/verify_blender_builds.py (M1-QA-02, ADR 0005). See docs/kb/qa/blender_builds.md.",
  "blender_version": "5.0.1",
  "blender_deb": "5.0.1+dfsg-5",
  "_threads": "M1-QA-06: Blender runs with --threads <n>, never the host's CPU count. A job that exports tangents runs single-threaded: Blender's threaded tangent export races (base_body differed run to run at 4 threads, and was stable at 1). Vegetation stopped exporting them (M1-ENV-07), so it is back at the default. Every other job is pinned at 4, the count its committed files were built with (Asha's body bakes change with the thread count). Verified on a 4-vCPU host only (M1-NIT-01). See docs/kb/qa/blender_builds.md.",
  "default_threads": 4,
  "copy_into_sandbox": ["assets_src"],
  "coverage_exempt": [],
  "jobs": [
    {
      "id": "base_body",
      "owner": "character",
      "sources": ["assets_src/characters/base_body/**", "assets_src/third_party/mpfb2/**"],
      "outputs": ["assets/characters/base_body/*.glb"],
      "threads": 1,
      "runs": [
        ["{blender}", "--python", "assets_src/characters/base_body/build.py", "--", "--variant", "slender", "--out", "assets/characters/base_body/base_body_slender.glb"],
        ["{blender}", "--python", "assets_src/characters/base_body/build.py", "--", "--variant", "athletic", "--out", "assets/characters/base_body/base_body_athletic.glb"],
        ["{blender}", "--python", "assets_src/characters/base_body/build.py", "--", "--variant", "heavy", "--out", "assets/characters/base_body/base_body_heavy.glb"]
      ]
    },
    {
      "id": "asha",
      "owner": "character",
      "sources": ["assets_src/characters/asha/**", "assets_src/characters/base_body/**", "assets_src/third_party/mpfb2/**"],
      "outputs": ["assets/characters/asha/*.glb", "assets/characters/asha/textures/*.png", "assets/characters/asha/materials/*.tres"],
      "runs": [
        ["{blender}", "--python", "assets_src/characters/asha/build_asha.py", "--", "--out", "assets/characters/asha/asha.glb", "--bake-dir", "{scratch}/asha_bake"],
        ["{python}", "assets_src/characters/asha/asha_textures.py", "--bake-dir", "{scratch}/asha_bake"],
        ["{python}", "assets_src/characters/asha/write_materials.py"]
      ]
    },
    {
      "id": "rhen",
      "owner": "character",
      "_note": "M2-CHR-01: Rhen reuses Asha's modules (build_asha as a helper library, asha_textures with per-hero knobs), so her sources are his too.",
      "sources": ["assets_src/characters/rhen/**", "assets_src/characters/asha/**", "assets_src/characters/base_body/**", "assets_src/third_party/mpfb2/**"],
      "outputs": ["assets/characters/rhen/*.glb", "assets/characters/rhen/textures/*.png", "assets/characters/rhen/materials/*.tres"],
      "runs": [
        ["{blender}", "--python", "assets_src/characters/rhen/build_rhen.py", "--", "--out", "assets/characters/rhen/rhen.glb", "--bake-dir", "{scratch}/rhen_bake"],
        ["{python}", "assets_src/characters/rhen/rhen_textures.py", "--bake-dir", "{scratch}/rhen_bake"],
        ["{python}", "assets_src/characters/rhen/write_materials.py"]
      ]
    },
    {
      "id": "toma",
      "owner": "character",
      "_note": "M2-CHR-02: Toma reuses Asha's modules (build_asha as a helper library, asha_textures with per-hero knobs) and Rhen's costume helpers (rhen_costume), so their sources are his too.",
      "sources": ["assets_src/characters/toma/**", "assets_src/characters/rhen/**", "assets_src/characters/asha/**", "assets_src/characters/base_body/**", "assets_src/third_party/mpfb2/**"],
      "outputs": ["assets/characters/toma/*.glb", "assets/characters/toma/textures/*.png", "assets/characters/toma/materials/*.tres"],
      "runs": [
        ["{blender}", "--python", "assets_src/characters/toma/build_toma.py", "--", "--out", "assets/characters/toma/toma.glb", "--bake-dir", "{scratch}/toma_bake"],
        ["{python}", "assets_src/characters/toma/toma_textures.py", "--bake-dir", "{scratch}/toma_bake"],
        ["{python}", "assets_src/characters/toma/write_materials.py"]
      ]
    },
    {
      "id": "villager_neme",
      "owner": "character",
      "_note": "M2-CHR-03: one parametric villager build (build_villager.py --npc, params/<npc>.json) on Asha's modules (build_asha as a helper library, asha_textures with per-villager knobs), Rhen's and Toma's costume and hair helpers, so all their sources are this job's too. The first job also writes the cloth atlas every villager shares (villager_textures.cloth_atlas, tinted per villager in its materials).",
      "sources": ["assets_src/characters/villagers/**", "assets_src/characters/toma/**", "assets_src/characters/rhen/**", "assets_src/characters/asha/**", "assets_src/characters/base_body/**", "assets_src/third_party/mpfb2/**"],
      "outputs": ["assets/characters/villagers/neme/*.glb", "assets/characters/villagers/neme/textures/*.png", "assets/characters/villagers/neme/materials/*.tres", "assets/characters/villagers/neme/*.tscn", "assets/characters/villagers/neme/anim/*.tres", "assets/characters/villagers/textures/*.png"],
      "runs": [
        ["{blender}", "--python", "assets_src/characters/villagers/build_villager.py", "--", "--npc", "neme", "--bake-dir", "{scratch}/neme_bake"],
        ["{python}", "assets_src/characters/villagers/villager_textures.py", "--cloth"],
        ["{python}", "assets_src/characters/villagers/villager_textures.py", "--npc", "neme", "--bake-dir", "{scratch}/neme_bake"],
        ["{python}", "assets_src/characters/villagers/write_materials.py", "neme"],
        ["{python}", "assets_src/characters/villagers/villager_clips.py", "neme"]
      ]
    },
    {
      "id": "villager_osu",
      "owner": "character",
      "sources": ["assets_src/characters/villagers/**", "assets_src/characters/toma/**", "assets_src/characters/rhen/**", "assets_src/characters/asha/**", "assets_src/characters/base_body/**", "assets_src/third_party/mpfb2/**"],
      "outputs": ["assets/characters/villagers/osu/*.glb", "assets/characters/villagers/osu/textures/*.png", "assets/characters/villagers/osu/materials/*.tres", "assets/characters/villagers/osu/*.tscn", "assets/characters/villagers/osu/anim/*.tres"],
      "runs": [
        ["{blender}", "--python", "assets_src/characters/villagers/build_villager.py", "--", "--npc", "osu", "--bake-dir", "{scratch}/osu_bake"],
        ["{python}", "assets_src/characters/villagers/villager_textures.py", "--npc", "osu", "--bake-dir", "{scratch}/osu_bake"],
        ["{python}", "assets_src/characters/villagers/write_materials.py", "osu"],
        ["{python}", "assets_src/characters/villagers/villager_clips.py", "osu"]
      ]
    },
    {
      "id": "villager_child",
      "owner": "character",
      "sources": ["assets_src/characters/villagers/**", "assets_src/characters/toma/**", "assets_src/characters/rhen/**", "assets_src/characters/asha/**", "assets_src/characters/base_body/**", "assets_src/third_party/mpfb2/**"],
      "outputs": ["assets/characters/villagers/child/*.glb", "assets/characters/villagers/child/textures/*.png", "assets/characters/villagers/child/materials/*.tres", "assets/characters/villagers/child/*.tscn", "assets/characters/villagers/child/anim/*.tres"],
      "runs": [
        ["{blender}", "--python", "assets_src/characters/villagers/build_villager.py", "--", "--npc", "child", "--bake-dir", "{scratch}/child_bake"],
        ["{python}", "assets_src/characters/villagers/villager_textures.py", "--npc", "child", "--bake-dir", "{scratch}/child_bake"],
        ["{python}", "assets_src/characters/villagers/write_materials.py", "child"],
        ["{python}", "assets_src/characters/villagers/villager_clips.py", "child"]
      ]
    },
    {
      "id": "villager_vendor",
      "owner": "character",
      "sources": ["assets_src/characters/villagers/**", "assets_src/characters/toma/**", "assets_src/characters/rhen/**", "assets_src/characters/asha/**", "assets_src/characters/base_body/**", "assets_src/third_party/mpfb2/**"],
      "outputs": ["assets/characters/villagers/vendor/*.glb", "assets/characters/villagers/vendor/textures/*.png", "assets/characters/villagers/vendor/materials/*.tres", "assets/characters/villagers/vendor/*.tscn", "assets/characters/villagers/vendor/anim/*.tres"],
      "runs": [
        ["{blender}", "--python", "assets_src/characters/villagers/build_villager.py", "--", "--npc", "vendor", "--bake-dir", "{scratch}/vendor_bake"],
        ["{python}", "assets_src/characters/villagers/villager_textures.py", "--npc", "vendor", "--bake-dir", "{scratch}/vendor_bake"],
        ["{python}", "assets_src/characters/villagers/write_materials.py", "vendor"],
        ["{python}", "assets_src/characters/villagers/villager_clips.py", "vendor"]
      ]
    },
    {
      "id": "villager_reed",
      "owner": "character",
      "sources": ["assets_src/characters/villagers/**", "assets_src/characters/toma/**", "assets_src/characters/rhen/**", "assets_src/characters/asha/**", "assets_src/characters/base_body/**", "assets_src/third_party/mpfb2/**"],
      "outputs": ["assets/characters/villagers/reed/*.glb", "assets/characters/villagers/reed/textures/*.png", "assets/characters/villagers/reed/materials/*.tres", "assets/characters/villagers/reed/*.tscn", "assets/characters/villagers/reed/anim/*.tres"],
      "runs": [
        ["{blender}", "--python", "assets_src/characters/villagers/build_villager.py", "--", "--npc", "reed", "--bake-dir", "{scratch}/reed_bake"],
        ["{python}", "assets_src/characters/villagers/villager_textures.py", "--npc", "reed", "--bake-dir", "{scratch}/reed_bake"],
        ["{python}", "assets_src/characters/villagers/write_materials.py", "reed"],
        ["{python}", "assets_src/characters/villagers/villager_clips.py", "reed"]
      ]
    },
    {
      "id": "villager_netmender",
      "owner": "character",
      "sources": ["assets_src/characters/villagers/**", "assets_src/characters/toma/**", "assets_src/characters/rhen/**", "assets_src/characters/asha/**", "assets_src/characters/base_body/**", "assets_src/third_party/mpfb2/**"],
      "outputs": ["assets/characters/villagers/netmender/*.glb", "assets/characters/villagers/netmender/textures/*.png", "assets/characters/villagers/netmender/materials/*.tres", "assets/characters/villagers/netmender/*.tscn", "assets/characters/villagers/netmender/anim/*.tres"],
      "runs": [
        ["{blender}", "--python", "assets_src/characters/villagers/build_villager.py", "--", "--npc", "netmender", "--bake-dir", "{scratch}/netmender_bake"],
        ["{python}", "assets_src/characters/villagers/villager_textures.py", "--npc", "netmender", "--bake-dir", "{scratch}/netmender_bake"],
        ["{python}", "assets_src/characters/villagers/write_materials.py", "netmender"],
        ["{python}", "assets_src/characters/villagers/villager_clips.py", "netmender"]
      ]
    },
    {
      "id": "villager_fisher",
      "owner": "character",
      "sources": ["assets_src/characters/villagers/**", "assets_src/characters/toma/**", "assets_src/characters/rhen/**", "assets_src/characters/asha/**", "assets_src/characters/base_body/**", "assets_src/third_party/mpfb2/**"],
      "outputs": ["assets/characters/villagers/fisher/*.glb", "assets/characters/villagers/fisher/textures/*.png", "assets/characters/villagers/fisher/materials/*.tres", "assets/characters/villagers/fisher/*.tscn", "assets/characters/villagers/fisher/anim/*.tres"],
      "runs": [
        ["{blender}", "--python", "assets_src/characters/villagers/build_villager.py", "--", "--npc", "fisher", "--bake-dir", "{scratch}/fisher_bake"],
        ["{python}", "assets_src/characters/villagers/villager_textures.py", "--npc", "fisher", "--bake-dir", "{scratch}/fisher_bake"],
        ["{python}", "assets_src/characters/villagers/write_materials.py", "fisher"],
        ["{python}", "assets_src/characters/villagers/villager_clips.py", "fisher"]
      ]
    },
    {
      "id": "shader_test",
      "owner": "rendering",
      "sources": ["assets_src/characters/shader_test/build_shader_test_meshes.py", "assets_src/characters/shader_test/layout.py"],
      "outputs": ["assets/characters/shader_test/*.glb"],
      "runs": [
        ["{blender}", "--python", "assets_src/characters/shader_test/build_shader_test_meshes.py"]
      ]
    },
    {
      "id": "vegetation",
      "owner": "environment",
      "sources": ["assets_src/environments/vegetation/*.py"],
      "outputs": ["assets/environments/vegetation/*.glb"],
      "runs": [
        ["{blender}", "--python", "assets_src/environments/vegetation/build.py", "--", "--all", "--out-dir", "assets/environments/vegetation"]
      ]
    },
    {
      "id": "haluna_kit",
      "owner": "environment",
      "sources": ["assets_src/environments/kits/haluna/*.py"],
      "outputs": ["assets/environments/kits/haluna/*.glb", "assets/environments/kits/haluna/kit_manifest.json"],
      "runs": [
        ["{blender}", "--python", "assets_src/environments/kits/haluna/build.py", "--", "--all", "--out-dir", "assets/environments/kits/haluna", "--manifest", "assets/environments/kits/haluna/kit_manifest.json"]
      ]
    }
  ]
}
