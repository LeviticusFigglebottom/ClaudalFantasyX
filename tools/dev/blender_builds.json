{
  "_doc": "Blender asset builds re-verified by tools/dev/verify_blender_builds.py (M1-QA-02, ADR 0005). See docs/kb/qa/blender_builds.md.",
  "blender_version": "5.0.1",
  "blender_deb": "5.0.1+dfsg-5",
  "_threads": "M1-QA-06: Blender runs with --threads <n>, never the host's CPU count. A job that exports tangents runs single-threaded: Blender's threaded tangent export races (base_body differed run to run at 4 threads, and was stable at 1). Vegetation stopped exporting them (M1-ENV-07), so it is back at the default. Every other job is pinned at 4, the count its committed files were built with (Asha's body bakes change with the thread count). Verified on a 4-vCPU host only (M1-NIT-01). See docs/kb/qa/blender_builds.md.",
  "default_threads": 4,
  "copy_into_sandbox": ["assets_src"],
  "coverage_exempt": [],
  "jobs": [
    {
      "id": "base_body",
      "owner": "character",
      "sources": ["assets_src/characters/base_body/**", "assets_src/third_party/mpfb2/**"],
      "outputs": ["assets/characters/base_body/*.glb"],
      "threads": 1,
      "runs": [
        ["{blender}", "--python", "assets_src/characters/base_body/build.py", "--", "--variant", "slender", "--out", "assets/characters/base_body/base_body_slender.glb"],
        ["{blender}", "--python", "assets_src/characters/base_body/build.py", "--", "--variant", "athletic", "--out", "assets/characters/base_body/base_body_athletic.glb"],
        ["{blender}", "--python", "assets_src/characters/base_body/build.py", "--", "--variant", "heavy", "--out", "assets/characters/base_body/base_body_heavy.glb"]
      ]
    },
    {
      "id": "asha",
      "owner": "character",
      "sources": ["assets_src/characters/asha/**", "assets_src/characters/base_body/**", "assets_src/third_party/mpfb2/**"],
      "outputs": ["assets/characters/asha/*.glb", "assets/characters/asha/textures/*.png", "assets/characters/asha/materials/*.tres"],
      "runs": [
        ["{blender}", "--python", "assets_src/characters/asha/build_asha.py", "--", "--out", "assets/characters/asha/asha.glb", "--bake-dir", "{scratch}/asha_bake"],
        ["{python}", "assets_src/characters/asha/asha_textures.py", "--bake-dir", "{scratch}/asha_bake"],
        ["{python}", "assets_src/characters/asha/write_materials.py"]
      ]
    },
    {
      "id": "shader_test",
      "owner": "rendering",
      "sources": ["assets_src/characters/shader_test/build_shader_test_meshes.py", "assets_src/characters/shader_test/layout.py"],
      "outputs": ["assets/characters/shader_test/*.glb"],
      "runs": [
        ["{blender}", "--python", "assets_src/characters/shader_test/build_shader_test_meshes.py"]
      ]
    },
    {
      "id": "vegetation", "threads": 4,
      "owner": "environment",
      "sources": ["assets_src/environments/vegetation/*.py"],
      "outputs": ["assets/environments/vegetation/*.glb"],
      "runs": [
        ["{blender}", "--python", "assets_src/environments/vegetation/build.py", "--", "--all", "--out-dir", "assets/environments/vegetation"]
      ]
    },
    {
      "id": "haluna_kit", "threads": 4,
      "owner": "environment",
      "sources": ["assets_src/environments/kits/haluna/*.py", "assets_src/environments/vegetation/banyan.py",
                  "assets_src/environments/vegetation/windbreak.py", "assets_src/environments/vegetation/canopy.py",
                  "assets_src/environments/vegetation/veg_common.py"],
      "outputs": ["assets/environments/kits/haluna/*.glb", "assets/environments/kits/haluna/kit_manifest.json"],
      "runs": [
        ["{blender}", "--python", "assets_src/environments/kits/haluna/build.py", "--", "--all", "--out-dir", "assets/environments/kits/haluna", "--manifest", "assets/environments/kits/haluna/kit_manifest.json"]
      ]
    },
    {
      "id": "tamsule_bell_kit",
      "owner": "environment",
      "sources": ["assets_src/environments/kits/tamsule_bell/*.py", "assets_src/environments/kits/haluna/kit_common.py", "assets_src/environments/kits/haluna/village.py", "assets_src/environments/kits/haluna/causeway.py"],
      "outputs": ["assets/environments/kits/tamsule_bell/*.glb", "assets/environments/kits/tamsule_bell/kit_manifest.json"],
      "runs": [
        ["{blender}", "--python", "assets_src/environments/kits/tamsule_bell/build.py", "--", "--all", "--out-dir", "assets/environments/kits/tamsule_bell", "--manifest", "assets/environments/kits/tamsule_bell/kit_manifest.json"]
      ]
    },
    {
      "id": "brine_shoals_kit",
      "owner": "environment",
      "_doc": "M3-ENV-02: the Brine Shoals kit. Geometry reuses the Haluna kit's core (kit_common, causeway, village) read-only; the two {python} steps rebuild its maps and materials, so they are verified too.",
      "sources": ["assets_src/environments/kits/brine_shoals/*.py", "assets_src/environments/kits/haluna/kit_common.py",
                  "assets_src/environments/kits/haluna/causeway.py", "assets_src/environments/kits/haluna/village.py",
                  "assets_src/environments/kits/haluna/kit_textures.py", "assets_src/environments/kits/haluna/materials.py",
                  "assets_src/environments/vegetation/textures.py"],
      "outputs": ["assets/environments/kits/brine_shoals/*.glb", "assets/environments/kits/brine_shoals/kit_manifest.json",
                  "assets/environments/kits/brine_shoals/textures/*.png", "assets/environments/kits/brine_shoals/materials/*.tres"],
      "runs": [
        ["{blender}", "--python", "assets_src/environments/kits/brine_shoals/build.py", "--", "--all", "--out-dir", "assets/environments/kits/brine_shoals", "--manifest", "assets/environments/kits/brine_shoals/kit_manifest.json"],
        ["{python}", "assets_src/environments/kits/brine_shoals/bs_textures.py"],
        ["{python}", "assets_src/environments/kits/brine_shoals/bs_materials.py"]
      ]
    },
    {
      "id": "pemakar_kit",
      "threads": 4,
      "owner": "environment",
      "_doc": "M3-ENV-03: the Pemakar kit (Terraces of Ash). Geometry reuses the Haluna kit's core (kit_common, village, shrine_interior) read-only; the two {python} steps rebuild its maps and materials, so they are verified too. Pinned at 4 threads like haluna_kit.",
      "sources": ["assets_src/environments/kits/pemakar/*.py", "assets_src/environments/kits/haluna/kit_common.py",
                  "assets_src/environments/kits/haluna/village.py", "assets_src/environments/kits/haluna/shrine_interior.py",
                  "assets_src/environments/kits/haluna/kit_textures.py", "assets_src/environments/kits/haluna/materials.py",
                  "assets_src/environments/vegetation/textures.py"],
      "outputs": ["assets/environments/kits/pemakar/*.glb", "assets/environments/kits/pemakar/kit_manifest.json",
                  "assets/environments/kits/pemakar/textures/*.png", "assets/environments/kits/pemakar/materials/*.tres"],
      "runs": [
        ["{blender}", "--python", "assets_src/environments/kits/pemakar/build.py", "--", "--all", "--out-dir", "assets/environments/kits/pemakar", "--manifest", "assets/environments/kits/pemakar/kit_manifest.json"],
        ["{python}", "assets_src/environments/kits/pemakar/pemakar_textures.py"],
        ["{python}", "assets_src/environments/kits/pemakar/pemakar_materials.py"]
      ]
    },
    {
      "id": "corrow_kit", "threads": 4,
      "owner": "environment",
      "_doc": "M3-ENV-04: the Corrow seawall kit. Geometry reuses the Haluna kit's core (kit_common, village's roof) and the Brine Shoals kit's heightfield (bs_common) read-only; pinned at 4 threads like haluna_kit. The two {python} steps rebuild its maps and materials, so they are verified too.",
      "sources": ["assets_src/environments/kits/corrow/*.py", "assets_src/environments/kits/haluna/kit_common.py",
                  "assets_src/environments/kits/haluna/village.py", "assets_src/environments/kits/haluna/kit_textures.py",
                  "assets_src/environments/kits/haluna/materials.py", "assets_src/environments/kits/brine_shoals/bs_common.py",
                  "assets_src/environments/vegetation/textures.py"],
      "outputs": ["assets/environments/kits/corrow/*.glb", "assets/environments/kits/corrow/kit_manifest.json",
                  "assets/environments/kits/corrow/textures/*.png", "assets/environments/kits/corrow/materials/*.tres"],
      "runs": [
        ["{blender}", "--python", "assets_src/environments/kits/corrow/build.py", "--", "--all", "--out-dir", "assets/environments/kits/corrow", "--manifest", "assets/environments/kits/corrow/kit_manifest.json"],
        ["{python}", "assets_src/environments/kits/corrow/cw_textures.py"],
        ["{python}", "assets_src/environments/kits/corrow/cw_materials.py"]
      ]
    },
    {
      "id": "oruvel_underway_kit", "threads": 4,
      "owner": "environment",
      "_doc": "M3-ENV-05: the Oruvel Underway kit (the Ch1 drowned tower and its sea floor). Geometry reuses the Haluna kit's core (kit_common) read-only; the two {python} steps rebuild its maps and materials (with the Haluna texture helpers and material writers), so they are verified too. Threads pinned at 4, as haluna_kit.",
      "sources": ["assets_src/environments/kits/oruvel_underway/*.py", "assets_src/environments/kits/haluna/kit_common.py",
                  "assets_src/environments/kits/haluna/kit_textures.py", "assets_src/environments/kits/haluna/materials.py",
                  "assets_src/environments/vegetation/textures.py"],
      "outputs": ["assets/environments/kits/oruvel_underway/*.glb", "assets/environments/kits/oruvel_underway/kit_manifest.json",
                  "assets/environments/kits/oruvel_underway/textures/*.png", "assets/environments/kits/oruvel_underway/materials/*.tres"],
      "runs": [
        ["{blender}", "--python", "assets_src/environments/kits/oruvel_underway/build.py", "--", "--all", "--out-dir", "assets/environments/kits/oruvel_underway", "--manifest", "assets/environments/kits/oruvel_underway/kit_manifest.json"],
        ["{python}", "assets_src/environments/kits/oruvel_underway/ou_textures.py"],
        ["{python}", "assets_src/environments/kits/oruvel_underway/ou_materials.py"]
      ]
        },
    {
      "id": "ashcrown_kit", "threads": 4,
      "owner": "environment",
      "_doc": "M3-ENV-09: the Ashcrown temple kit (Ch5, the Lightning temple at the plume's foot). Geometry reuses the Haluna kit's core (kit_common, village's hip roof) and the Pemakar kit's common and skyline modules (the ash pass, massif_height, the far Ashcrown's numbers) read-only; the two {python} steps rebuild its maps and materials (with the Haluna texture helpers and material writers and the Pemakar material defaults), so they are verified too. Threads pinned at 4, as haluna_kit.",
      "sources": ["assets_src/environments/kits/ashcrown/*.py", "assets_src/environments/kits/haluna/kit_common.py",
                  "assets_src/environments/kits/haluna/village.py", "assets_src/environments/kits/haluna/kit_textures.py",
                  "assets_src/environments/kits/haluna/materials.py", "assets_src/environments/kits/pemakar/pemakar_common.py",
                  "assets_src/environments/kits/pemakar/pemakar_skyline.py", "assets_src/environments/kits/pemakar/pemakar_materials.py",
                  "assets_src/environments/vegetation/textures.py"],
      "outputs": ["assets/environments/kits/ashcrown/*.glb", "assets/environments/kits/ashcrown/kit_manifest.json",
                  "assets/environments/kits/ashcrown/textures/*.png", "assets/environments/kits/ashcrown/materials/*.tres"],
      "runs": [
        ["{blender}", "--python", "assets_src/environments/kits/ashcrown/build.py", "--", "--all", "--out-dir", "assets/environments/kits/ashcrown", "--manifest", "assets/environments/kits/ashcrown/kit_manifest.json"],
        ["{python}", "assets_src/environments/kits/ashcrown/ac_textures.py"],
        ["{python}", "assets_src/environments/kits/ashcrown/ac_materials.py"]
      ]
    }
  ]
}
