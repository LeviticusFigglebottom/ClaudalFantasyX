{
  "_doc": "Blender asset builds re-verified by tools/dev/verify_blender_builds.py (M1-QA-02, ADR 0005). See docs/kb/qa/blender_builds.md.",
  "blender_version": "5.0.1",
  "blender_deb": "5.0.1+dfsg-5",
  "_threads": "M1-QA-06: Blender runs with --threads <n>, never the host's CPU count. A job that exports tangents runs single-threaded: Blender's threaded tangent export races (base_body differed run to run at 4 threads, and was stable at 1). Vegetation stopped exporting them (M1-ENV-07), so it is back at the default. Every other job is pinned at 4, the count its committed files were built with (Asha's body bakes change with the thread count). Verified on a 4-vCPU host only (M1-NIT-01). See docs/kb/qa/blender_builds.md.",
  "default_threads": 4,
  "copy_into_sandbox": ["assets_src"],
  "coverage_exempt": [],
  "jobs": [
    {
      "id": "base_body",
      "owner": "character",
      "sources": ["assets_src/characters/base_body/**", "assets_src/third_party/mpfb2/**"],
      "outputs": ["assets/characters/base_body/*.glb"],
      "threads": 1,
      "runs": [
        ["{blender}", "--python", "assets_src/characters/base_body/build.py", "--", "--variant", "slender", "--out", "assets/characters/base_body/base_body_slender.glb"],
        ["{blender}", "--python", "assets_src/characters/base_body/build.py", "--", "--variant", "athletic", "--out", "assets/characters/base_body/base_body_athletic.glb"],
        ["{blender}", "--python", "assets_src/characters/base_body/build.py", "--", "--variant", "heavy", "--out", "assets/characters/base_body/base_body_heavy.glb"]
      ]
    },
    {
      "id": "asha",
      "owner": "character",
      "sources": ["assets_src/characters/asha/**", "assets_src/characters/base_body/**", "assets_src/third_party/mpfb2/**"],
      "outputs": ["assets/characters/asha/*.glb", "assets/characters/asha/textures/*.png", "assets/characters/asha/materials/*.tres"],
      "runs": [
        ["{blender}", "--python", "assets_src/characters/asha/build_asha.py", "--", "--out", "assets/characters/asha/asha.glb", "--bake-dir", "{scratch}/asha_bake"],
        ["{python}", "assets_src/characters/asha/asha_textures.py", "--bake-dir", "{scratch}/asha_bake"],
        ["{python}", "assets_src/characters/asha/write_materials.py"]
      ]
    },
    {
      "id": "rhen",
      "owner": "character",
      "_note": "M2-CHR-01: Rhen reuses Asha's modules (build_asha as a helper library, asha_textures with per-hero knobs), so her sources are his too.",
      "sources": ["assets_src/characters/rhen/**", "assets_src/characters/asha/**", "assets_src/characters/base_body/**", "assets_src/third_party/mpfb2/**"],
      "outputs": ["assets/characters/rhen/*.glb", "assets/characters/rhen/textures/*.png", "assets/characters/rhen/materials/*.tres"],
      "runs": [
        ["{blender}", "--python", "assets_src/characters/rhen/build_rhen.py", "--", "--out", "assets/characters/rhen/rhen.glb", "--bake-dir", "{scratch}/rhen_bake"],
        ["{python}", "assets_src/characters/rhen/rhen_textures.py", "--bake-dir", "{scratch}/rhen_bake"],
        ["{python}", "assets_src/characters/rhen/write_materials.py"]
      ]
    },
    {
      "id": "toma",
      "owner": "character",
      "_note": "M2-CHR-02: Toma reuses Asha's modules (build_asha as a helper library, asha_textures with per-hero knobs) and Rhen's costume helpers (rhen_costume), so their sources are his too.",
      "sources": ["assets_src/characters/toma/**", "assets_src/characters/rhen/**", "assets_src/characters/asha/**", "assets_src/characters/base_body/**", "assets_src/third_party/mpfb2/**"],
      "outputs": ["assets/characters/toma/*.glb", "assets/characters/toma/textures/*.png", "assets/characters/toma/materials/*.tres"],
      "runs": [
        ["{blender}", "--python", "assets_src/characters/toma/build_toma.py", "--", "--out", "assets/characters/toma/toma.glb", "--bake-dir", "{scratch}/toma_bake"],
        ["{python}", "assets_src/characters/toma/toma_textures.py", "--bake-dir", "{scratch}/toma_bake"],
        ["{python}", "assets_src/characters/toma/write_materials.py"]
      ]
    },
    {
      "id": "shader_test",
      "owner": "rendering",
      "sources": ["assets_src/characters/shader_test/build_shader_test_meshes.py", "assets_src/characters/shader_test/layout.py"],
      "outputs": ["assets/characters/shader_test/*.glb"],
      "runs": [
        ["{blender}", "--python", "assets_src/characters/shader_test/build_shader_test_meshes.py"]
      ]
    },
    {
      "id": "vegetation",
      "owner": "environment",
      "sources": ["assets_src/environments/vegetation/*.py"],
      "outputs": ["assets/environments/vegetation/*.glb"],
      "runs": [
        ["{blender}", "--python", "assets_src/environments/vegetation/build.py", "--", "--all", "--out-dir", "assets/environments/vegetation"]
      ]
    },
    {
      "id": "haluna_kit",
      "owner": "environment",
      "sources": ["assets_src/environments/kits/haluna/*.py"],
      "outputs": ["assets/environments/kits/haluna/*.glb", "assets/environments/kits/haluna/kit_manifest.json"],
      "runs": [
        ["{blender}", "--python", "assets_src/environments/kits/haluna/build.py", "--", "--all", "--out-dir", "assets/environments/kits/haluna", "--manifest", "assets/environments/kits/haluna/kit_manifest.json"]
      ]
    }
  ]
}
