      "outputs": ["assets/characters/villagers/osu/*.glb", "assets/characters/villagers/osu/textures/*.png", "assets/characters/villagers/osu/materials/*.tres", "assets/characters/villagers/osu/*.tscn", "assets/characters/villagers/osu/anim/*.tres"],
      "runs": [
