extends Node
## Writes game/data/ui/scene_loads.json (ADR 0111 amendment, the PC's 4-6 s first entries): for every Act I zone
## in game/data/world/locations.json, the resources its nodes hold once it has entered the tree. Most are loaded
## at runtime by the zone's own scripts (ZoneCast's villagers, ZoneKitDressing's kit pieces and materials), so the
## scene's threaded load never sees them; ResidentLoads loads them on worker threads behind the fade instead.
## Run headless after a zone's cast or dressing changes (the test checks every zone has a list):
##   godot --headless --path . res://tools/loading/scene_loads.tscn

## Frames each zone runs before its holdings are collected, so deferred builds are in.
const SETTLE_FRAMES := 3
const LOCATIONS := "res://game/data/world/locations.json"
const OUT := "res://game/data/ui/scene_loads.json"
## Act I (ADR 0041): the prologue and chapters 1-9.
const PREFIXES: Array[String] = [
	"prologue", "ch01/", "ch02/", "ch03/", "ch04/", "ch05/", "ch06/", "ch07/", "ch08/", "ch09/"
]


func _ready() -> void:
	await get_tree().process_frame
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(LOCATIONS))
	var table: Variant = (parsed as Dictionary).get("locations", parsed)
	var scenes: Array[String] = []
	var rows: Array = (table as Dictionary).values() if table is Dictionary else table as Array
	var ids: Array = (
		(table as Dictionary).keys()
		if table is Dictionary
		else rows.map(func(r: Dictionary) -> String: return str(r.get("id", "")))
	)
	for i in rows.size():
		var id := str(ids[i])
		var scene := str((rows[i] as Dictionary).get("scene", ""))
		if scene != "" and PREFIXES.any(func(p: String) -> bool: return id.begins_with(p)) and not scenes.has(scene):
			scenes.append(scene)
	scenes.sort()
	var out := {}
	for scene in scenes:
		if not ResourceLoader.exists(scene):
			continue
		var node := (load(scene) as PackedScene).instantiate()
		get_tree().root.add_child(node)
		# Deferred builds (VillagerLayer builds once the zone's own set-up is done) load at runtime too.
		for f in SETTLE_FRAMES:
			await get_tree().process_frame
		var found := {}
		_collect(node, found)
		_collect_casts(node, found)
		found.erase(scene)
		var list: Array = found.keys()
		list.sort()
		out[scene] = list
		print("SCENE_LOADS %s: %d" % [scene, list.size()])
		node.free()
		await get_tree().process_frame
	var doc := {
		"scene_loads":
		{
			"doc":
			(
				"Generated by tools/loading/scene_loads.gd (ADR 0111): per Act I zone, the resources it holds once"
				+ " in the tree. ResidentLoads loads a change's list on worker threads behind the fade and holds the"
				+ " swap until they are in. Do not edit by hand: rerun the tool."
			),
			"scenes": out,
		}
	}
	var f := FileAccess.open(OUT, FileAccess.WRITE)
	f.store_string(JSON.stringify(doc, "  ", true) + "\n")
	f.close()
	print("SCENE_LOADS wrote %d scenes to %s" % [out.size(), OUT])
	get_tree().quit()


## Every resource path `n` and its subtree hold: instanced scenes, and resources in object properties (meshes,
## materials, environments, shaders) and surface override materials. Sub-resources ("::") are left out.
func _collect(n: Node, out: Dictionary) -> void:
	if n.scene_file_path != "":
		out[n.scene_file_path] = true
	for prop in n.get_property_list():
		if int(prop["type"]) == TYPE_OBJECT:
			var v: Variant = n.get(str(prop["name"]))
			if v is Resource:
				_res(v as Resource, out)
	if n is MeshInstance3D:
		var mi := n as MeshInstance3D
		for i in mi.get_surface_override_material_count():
			if mi.get_surface_override_material(i) != null:
				_res(mi.get_surface_override_material(i), out)
	for c in n.get_children(true):
		_collect(c, out)


## Every model a zone's stage actors are cast as (ZoneCast: villagers and creatures; heroes are resident already).
## The villager layer adopts or replaces a cast body after it is built (big19's PC pass 4, row 67: Brine Shoals'
## and Corrow's casts were never listed, so each loaded cold in the change), so the tree no longer holds them by the
## time _collect runs: they are read from the layout's `cast` rows instead.
func _collect_casts(n: Node, out: Dictionary) -> void:
	var zone := n as GreyboxZone
	if zone == null:
		return
	for row: Variant in (zone.layout.get("actors", {}) as Dictionary).values():
		var cast := str((row as Dictionary).get(ZoneCast.KEY_CAST, "")) if row is Dictionary else ""
		if cast == "" or cast.begins_with(ZoneCast.PREFIX_HERO):
			continue
		var path := ZoneCast.scene_path(cast)
		if path != "":
			out[path] = true


func _res(r: Resource, out: Dictionary) -> void:
	var p := r.resource_path
	if p.begins_with("res://") and not p.contains("::"):
		out[p] = true
